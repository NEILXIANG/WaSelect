{
  "description": "WaSelect 日本直邮跨境电商（地基骨架期）",
  "compileType": "miniprogram",
  "libVersion": "3.5.5",
  "appid": "touristappid",
  "projectname": "waselect",
  "packOptions": {
    "ignore": [
      {
        "type": "glob",
        "value": "**/*.unit.test.ts"
      },
      {
        "type": "glob",
        "value": "**/*.fixture.js"
      },
      {
        "type": "glob",
        "value": "**/.DS_Store"
      },
      {
        "type": "folder",
        "value": "pages/index"
      },
      {
        "type": "folder",
        "value": "pages/comp"
      }
    ],
    "include": []
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "useCompilerPlugins": ["typescript"],
    "postcss": true,
    "minified": true,
    "newFeature": true,
    "coverView": true,
    "nodeModules": false,
    "autoAudits": false,
    "showShadowRootInWxmlPanel": true,
    "scopeCheck": false,
    "checkSiteMap": true,
    "compileHotReLoad": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "condition": {
    "miniprogram": {
      "list": []
    }
  }
}
