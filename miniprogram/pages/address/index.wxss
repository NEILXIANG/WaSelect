/**
 * 地址列表页样式。
 *
 * ⚠️ 颜色与尺寸一律走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件，
 * 硬编码色值 / 非 0 尺寸字面量直接红）。
 */

/* 收件人 + 默认标记同一行（不用 flex gap，基础库支持不一致） */
.addr-head {
  display: flex;
  align-items: baseline;
}

.name {
  color: var(--ws-color-fg);
  font-size: var(--ws-font);
}

.tag {
  margin-left: var(--ws-space-sm);
  color: var(--ws-color-muted);
  font-size: var(--ws-font-sm);
}

.line {
  display: block;
  margin-top: var(--ws-space-sm);
  color: var(--ws-color-muted);
  font-size: var(--ws-font-sm);
}

/* 操作区：文字按钮排一行（用 view 不是 button——页面不允许原生可点 button） */
.acts {
  display: flex;
  margin-top: var(--ws-space);
}

.act {
  margin-right: var(--ws-space);
  color: var(--ws-color-fg);
  font-size: var(--ws-font-sm);
}
