<!--
  地址列表（I2）：我的地址 + 编辑/删除/设默认；`?pick=1` 时为结算页选地址。

  S3（2026-10-02）：版式换成设计体系（`.ws-*` 基础类），**信息架构与行为都不动**——
  加载 / 错误 / 空 / 列表 / 四个动作（编辑·删除·设默认·用这个）一个没少，只是换皮。

  ⚠️ 空态只在**确实没有地址**时显示——请求失败时显示"还没有地址"是在说假话
  （用户会以为自己没存过，于是再存一遍，结果两条一样的地址）。
  @see index.vm.js 的 emptyState

  ⚠️ 删除走 showModal 二次确认（不可撤销），不在 wxml 里直接绑删除。
-->
<view class="ws-page ws-page--with-buybar">
  <!-- 区块标题（S4：走组件，不再每页各写一份 kicker + 主标） -->
  <!-- 外边距放在包一层的 view 上：类名写在自定义组件标签上时页面的 ws-gutter 不生效（模拟器截图实测：标题贴左边） -->
  <view class="ws-gutter addr__head"><ws-section-head kicker="Address Book" title="收货地址" /></view>

  <!-- 状态块（S4：走 `ws-state-block` 的三段式） -->
  <!-- 审计 UX-05：已有内容时（onShow 刷新）不在列表上方插整块"正在加载"，列表原样留着等新数据替换 -->
  <ws-state-block wx:if="{{loading && rows.length === 0}}" kind="loading" title="正在加载地址" compact="{{true}}" />

  <ws-state-block
    wx:if="{{error}}"
    kind="fail"
    title="{{errorTitle}}"
    reason="{{error}}"
    refText="{{errorRef}}"
    actionText="{{errorContact ? '联系客服' : '重试'}}"
    bindaction="onRetry"
  />

  <ws-state-block
    wx:if="{{empty}}"
    kind="empty"
    title="还没有收货地址"
    reason="添加地址后，下次结算可以直接选它，不用再手打一遍"
    compact="{{true}}"
  />

  <!-- 全入口点击测试 2026-10-11：选择模式说明"点地址即选用"（整张卡可点，见 onCardTap） -->
  <view class="ws-gutter" wx:if="{{pick && rows.length > 0}}">
    <text class="ws-note addr__pick-hint">点一个地址即可选用</text>
  </view>
  <view class="ws-gutter addr__list">
    <!--
      全入口点击测试 2026-10-11：整张卡可点（选择模式 = 选中；管理模式 = 编辑）；卡内动作用 catchtap，不连带触发整卡。
      卡片收紧：姓名与电话同一行、门牌两行合成一行（原先每张卡占三分之一屏，20 个地址要滑很久）。
    -->
    <view
      class="ws-card addr"
      wx:for="{{rows}}"
      wx:key="id"
      data-id="{{item.id}}"
      hover-class="ws-press"
      bindtap="onCardTap"
    >
      <view class="addr__top">
        <text class="ws-title addr__name">{{item.recipient}}</text>
        <text class="ws-note addr__phone">{{item.phone}}</text>
        <!-- 默认标记：用 tag 而不是"括号里的字"——括号里的"默认"会和电话读成一行 -->
        <text class="ws-tag addr__default" wx:if="{{item.isDefault}}">{{item.defaultText}}</text>
      </view>
      <text class="ws-body addr__line">{{item.line1}}{{item.line2 ? ', ' + item.line2 : ''}}</text>
      <text class="ws-note addr__line">{{item.region}}</text>
      <!-- 操作区：文字动作排一行（用 view 不是 button——页面不允许原生可点 button）；选择模式只留「编辑」 -->
      <view class="ws-hair addr__rule" />
      <view class="addr__acts">
        <view class="addr__act" data-id="{{item.id}}" hover-class="ws-press" catchtap="onEdit">
          编辑
        </view>
        <view class="addr__act" wx:if="{{!pick}}" data-id="{{item.id}}" hover-class="ws-press" catchtap="onDelete">
          {{busyId === item.id ? '处理中…' : '删除'}}
        </view>
        <view
          class="addr__act"
          wx:if="{{!pick && !item.isDefault}}"
          data-id="{{item.id}}"
          hover-class="ws-press"
          catchtap="onSetDefault"
        >
          {{busyId === item.id ? '处理中…' : '设为默认'}}
        </view>
        <view
          class="addr__act addr__act--accent"
          wx:if="{{pick}}"
          data-id="{{item.id}}"
          hover-class="ws-press"
          catchtap="onPick"
        >
          用这个地址
        </view>
      </view>
    </view>
  </view>

  <!-- 全入口点击测试 2026-10-11：新增按钮固定在底部（原先排在列表最后，地址一多要滑到底才找得到） -->
  <!-- 两端逐页走查第三轮 2026-10-12：账号受限时不出新增按钮（点进去填完也存不上；上面已给「联系客服」） -->
  <view class="ws-buybar" wx:if="{{!errorContact}}">
    <ws-button text="＋ 新增收货地址" type="primary" block="{{true}}" bindtap="onAdd" />
  </view>
</view>
