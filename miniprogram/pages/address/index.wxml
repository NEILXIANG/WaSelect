<!--
  地址列表（I2）：我的地址 + 编辑/删除/设默认；`?pick=1` 时为结算页选地址。

  S3（2026-10-02）：版式换成设计体系（`.ws-*` 基础类），**信息架构与行为都不动**——
  加载 / 错误 / 空 / 列表 / 四个动作（编辑·删除·设默认·用这个）一个没少，只是换皮。

  ⚠️ 空态只在**确实没有地址**时显示——请求失败时显示"还没有地址"是在说假话
  （用户会以为自己没存过，于是再存一遍，结果两条一样的地址）。
  @see index.vm.js 的 emptyState

  ⚠️ 删除走 showModal 二次确认（不可撤销），不在 wxml 里直接绑删除。
-->
<view class="ws-page">
  <!-- 区块标题（S4：走组件，不再每页各写一份 kicker + 主标） -->
  <ws-section-head class="ws-gutter addr__head" kicker="Address Book" title="收货地址" />

  <!-- 状态块（S4：走 `ws-state-block` 的三段式） -->
  <ws-state-block wx:if="{{loading}}" kind="loading" title="正在加载地址" compact="{{true}}" />

  <ws-state-block
    wx:if="{{error}}"
    kind="fail"
    title="{{errorTitle}}"
    reason="{{error}}"
    refText="{{errorRef}}"
    actionText="重试"
    bindaction="onRetry"
  />

  <ws-state-block
    wx:if="{{empty}}"
    kind="empty"
    title="还没有收货地址"
    reason="添加地址后，下次结算可以直接选它，不用再手打一遍"
    compact="{{true}}"
  />

  <view class="ws-gutter addr__list">
    <view class="ws-card addr" wx:for="{{rows}}" wx:key="id">
      <view class="addr__head">
        <text class="ws-title addr__name">{{item.recipient}}</text>
        <!-- 默认标记：用 tag 而不是"括号里的字"——括号里的"默认"会和电话读成一行 -->
        <text class="ws-tag addr__default" wx:if="{{item.isDefault}}">{{item.defaultText}}</text>
      </view>

      <text class="ws-note addr__line">{{item.phone}}</text>
      <text class="ws-body addr__line">{{item.line1}}</text>
      <text class="ws-body addr__line" wx:if="{{item.line2}}">{{item.line2}}</text>
      <text class="ws-note addr__line">{{item.region}}</text>

      <!-- 操作区：文字动作排一行（用 view 不是 button——页面不允许原生可点 button） -->
      <view class="ws-hair addr__rule" />
      <view class="addr__acts">
        <view class="addr__act" data-id="{{item.id}}" hover-class="ws-press" bindtap="onEdit">
          编辑
        </view>
        <view class="addr__act" data-id="{{item.id}}" hover-class="ws-press" bindtap="onDelete">
          删除
        </view>
        <view
          class="addr__act"
          wx:if="{{!item.isDefault}}"
          data-id="{{item.id}}"
          hover-class="ws-press"
          bindtap="onSetDefault"
        >
          设为默认
        </view>
        <view
          class="addr__act addr__act--accent"
          wx:if="{{pick}}"
          data-id="{{item.id}}"
          hover-class="ws-press"
          bindtap="onPick"
        >
          用这个地址
        </view>
      </view>
    </view>
  </view>

  <view class="ws-gutter addr__foot">
    <ws-button text="新增地址" type="primary" bindtap="onAdd" />
  </view>
</view>
