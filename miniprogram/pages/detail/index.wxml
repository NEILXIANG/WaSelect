<!--
  商品详情页（I2）：轮播 + 标题/价格 + 规格 + 描述；M-02 编辑口径、M-03 购买保障 / 运输流程 / 客服（AJ-405）。

  S3（2026-10-02）：版式换成设计体系（`.ws-*` 基础类），信息架构不动。

  M-13（AJ-406）：底部**固定**购买栏（价格 + 购物车入口 + 加入购物车 + 立即购买），
  栏高走 token `--ws-buybar-h`，页面根用 `.ws-page--with-buybar` 留出同样的底部空白（含 safe-area），
  最后一段内容不会被栏遮住。原先加购后出现的「去购物车」按钮去掉：购物车入口已常驻在栏里，不重复。

  样式只走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件对应的 wxss，
  出现硬编码色值 / 尺寸字面量会直接红）。
-->
<view class="ws-page detail {{product ? 'ws-page--with-buybar' : ''}}">
  <!-- 小程序评估 B（AJ-416）：首次加载出骨架（大图位 + 标题 / 价格行），不再是一张"加载中…"卡片 -->
  <view class="ws-gutter" wx:if="{{loading && !product}}" aria-label="正在加载商品">
    <view class="ws-media ws-media--hero ws-skeleton" />
    <view class="ws-skeleton skel-line" />
    <view class="ws-skeleton skel-line skel-line--short" />
  </view>

  <!-- P2-38：错误态走三段式组件并给"重试"（以前只有一行红字，用户只能退出重进） -->
  <ws-state-block
    wx:if="{{error}}"
    kind="{{failKind}}"
    title="{{failTitle}}"
    reason="{{error}}"
    refText="{{errorRef}}"
    actionText="{{retryable ? '重试' : '去首页逛逛'}}"
    bindaction="onStateAction"
  />

  <block wx:if="{{product}}">
    <!-- 轮播：images 已由 vm 保证至少一条（空 → 占位图），不会出现空 swiper -->
    <swiper class="gallery" indicator-dots>
      <swiper-item wx:for="{{product.images}}" wx:key="*this">
        <!-- M-18（AJ-406）：首张之外的图滑到附近才加载（swiper 内 lazy-load 生效范围【需真机确认】） -->
        <image class="gallery-image" src="{{item}}" mode="aspectFit" lazy-load="{{index > 0}}" />
      </swiper-item>
    </swiper>

    <!--
      M-02（AJ-405）：与首页 ws-pick-card 同一套视觉语言——产地/匠人在名字上方一行小字，
      「为什么值得买」在名字下、价格上（编辑批注样式：左竖线 + 浅底），编辑标签跟在价格后。
      三项都可缺（契约 0.6.23②）：缺了整块不渲染，不用通用话术顶上。
    -->
    <view class="ws-gutter detail__head">
      <text class="detail__maker" wx:if="{{product.maker}}">{{product.maker}}</text>
      <text class="detail__title">{{product.title}}</text>
      <view class="detail__why" wx:if="{{product.why}}">
        <text class="detail__why-label">为什么值得买</text>
        <text class="detail__why-text">{{product.why}}</text>
      </view>
      <ws-price jpy="{{product.priceJpy}}" size="lg" />
      <!-- 走查 2026-10-08：与价格之间留一点空（原先"9,800 円≈ $67.63"粘在一起） -->
      <text class="ws-note detail__sub-price" wx:if="{{product.subPrice}}">{{product.subPrice}}</text>
      <text class="ws-tag ws-tag--danger detail__tag" wx:if="{{product.soldOut}}">已售罄</text>
      <text class="ws-tag ws-tag--danger detail__tag" wx:if="{{product.lowStockText}}">{{product.lowStockText}}</text>
      <view class="detail__tags" wx:if="{{product.tags.length > 0}}">
        <text class="ws-tag" wx:for="{{product.tags}}" wx:key="*this">{{item}}</text>
      </view>
      <!--
        M-03（AJ-405）：保障标签条。提审前必须的关税口径与发货时限（PRD §3 / D-32 / D-39⑦ FTC）
        以标签出现在价格下方，逐条说明在下面的「购买保障」区；文案全部由 vm 给出。
        绿色标签与上面的编辑标签区分：这里是**店铺承诺**，那里是**编辑口径**。
      -->
      <view class="detail__tags">
        <text class="ws-tag ws-tag--green" wx:for="{{product.guarantees}}" wx:key="key">{{item.tag}}</text>
      </view>

      <!-- A9（AJ-416）：数量——加入购物车与立即购买都按它来（1 起步，不超过库存）。售罄时不出现 -->
      <view class="qty-row" wx:if="{{!product.soldOut}}">
        <text class="ws-note">数量</text>
        <view class="qty-row__ctl">
          <!-- MP-12（第二轮审计）：类名原为 .step，与下方"运输流程"的 .step 同名，后写的规则把流程行套成了居中大字 -->
          <view class="qty-step" hover-class="ws-press" bindtap="onQtyMinus" aria-role="button" aria-label="减少数量">−</view>
          <text class="qty-row__value" aria-label="数量 {{qty}}">{{qty}}</text>
          <view class="qty-step" hover-class="ws-press" bindtap="onQtyPlus" aria-role="button" aria-label="增加数量">＋</view>
        </view>
      </view>
      <!-- F8：点「＋」点不动时说为什么 -->
      <text class="ws-note" wx:if="{{qtyNote}}">{{qtyNote}}</text>

      <view class="specs" wx:if="{{product.specs.length > 0}}">
        <view class="spec" wx:for="{{product.specs}}" wx:for-item="row" wx:key="label">
          <text class="ws-note spec__k">{{row.label}}</text>
          <text class="ws-body spec__v">{{row.value}}</text>
        </view>
      </view>
    </view>

    <view class="ws-gutter ws-section" wx:if="{{product.description}}">
      <view class="ws-card">
        <text class="ws-section-kicker">商品介绍</text>
        <text class="ws-body">{{product.description}}</text>
      </view>
    </view>

    <!-- M-03：购买保障逐条说明（与价格下的标签一一对应） -->
    <view class="ws-gutter ws-section">
      <view class="ws-card">
        <text class="ws-section-kicker">购物保障</text>
        <view class="assure" wx:for="{{product.guarantees}}" wx:key="key">
          <text class="ws-body assure__tag">{{item.tag}}</text>
          <text class="ws-note">{{item.detail}}</text>
        </view>
      </view>
    </view>

    <!--
      M-03：运输流程分段说明。⚠️ **不写天数**（AJ-402 Q2）：EMS 实测前任何数字都是猜，
      实测后由服务端配置下发，在这里加一行"约 X–Y 天（参考）"。
    -->
    <view class="ws-gutter ws-section">
      <view class="ws-card">
        <text class="ws-section-kicker">配送流程</text>
        <view class="step" wx:for="{{product.shippingSteps}}" wx:key="key">
          <text class="ws-tag ws-tag--ghost step__no">{{index + 1}}</text>
          <view class="step__body">
            <text class="ws-body step__title">{{item.title}}</text>
            <text class="ws-note">{{item.detail}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- M-03：联系客服（复用 GET /support 与 utils/support.js；服务端未配置时不显示，长按可选中复制） -->
    <view class="ws-gutter ws-section" wx:if="{{support.length > 0}}">
      <view class="ws-card">
        <text class="ws-note">有疑问？联系客服</text>
        <view class="spec" wx:for="{{support}}" wx:key="key">
          <text class="ws-note spec__k">{{item.label}}</text>
          <text class="ws-body spec__v" user-select>{{item.value}}</text>
        </view>
      </view>
    </view>

    <!-- A10（AJ-416）：同类推荐（最多 4 件，两列小卡）；取不到就整块不出现 -->
    <view class="ws-gutter ws-section" wx:if="{{related.length > 0}}">
      <text class="ws-section-kicker">相似推荐</text>
      <view class="related">
        <view
          class="related__item"
          wx:for="{{related}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onOpenRelated"
          hover-class="ws-press"
          aria-role="link"
          aria-label="查看 {{item.title}}"
        >
          <view class="ws-media ws-media--square">
            <image class="ws-media__img" src="{{item.image}}" mode="aspectFill" lazy-load />
          </view>
          <text class="ws-body related__title">{{item.title}}</text>
          <ws-price jpy="{{item.priceJpy}}" size="sm" />
        </view>
      </view>
    </view>

    <!--
      M-13（AJ-406）：底部固定购买栏。剩余清单 4-4："立即购买"只结这一件、不动购物车（结算页 ?mode=buynow）；
      "加入购物车"为次按钮（加购成功后按钮写"已加入购物车"，再点照样加）。左侧是常驻的购物车格子（文字固定、件数进角标）。
      加不进去的原因（品种已满，P2-31）在栏的最上方一行，紧挨按钮。
    -->
    <view class="buy-bar">
      <text class="ws-note state__error buy-bar__note" wx:if="{{addNote}}">{{addNote}}</text>
      <view class="buy-bar__row">
        <!-- 全入口点击测试 2026-10-11：左侧原为"价格 + 一行小字「购物车 ›」"——价格与上方重复、购物车入口太小不醒目。
             改为整栏高的购物车格子（短文字 + 件数角标），与京东 / 淘宝详情页底栏同一结构 -->
        <view
          class="buy-bar__cart"
          hover-class="ws-press"
          bindtap="onGoCart"
          aria-role="link"
          aria-label="{{bar.cartAria}}"
        >
          <text class="buy-bar__cart-label">{{bar.cartLabel}}</text>
          <text class="buy-bar__cart-badge" wx:if="{{bar.cartBadge}}">{{bar.cartBadge}}</text>
        </view>
        <view class="buy-bar__btn">
          <ws-button text="{{bar.addText}}" type="default" block="{{true}}" disabled="{{bar.disabled}}" bindtap="onAddToCart" />
        </view>
        <view class="buy-bar__btn">
          <ws-button text="立即购买" type="primary" block="{{true}}" disabled="{{bar.disabled}}" bindtap="onBuyNow" />
        </view>
      </view>
    </view>
  </block>
</view>
