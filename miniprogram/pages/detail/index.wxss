/**
 * 商品详情页样式（S3 已切到设计体系基础类）。
 *
 * ⚠️ 颜色与尺寸一律走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件，
 * 硬编码色值 / 非 0 尺寸字面量直接红）。
 *
 * @limitation 主图位定为正方形（`--ws-gallery-h`，屏宽）：竖长图、横宽图在里面都会留白；
 *             占首屏约一半高度，换来"看得到整张图"。
 *             （更正 2026-10-11：此前写"不显式给高度、aspectFit 保证全图可见"不成立——
 *             swiper 默认 150px、image 默认 240px，模拟器实测图被裁掉下半截；守卫见 `swiper-height.unit.test.ts`。）
 */

/* 轮播：aspectFit 让非一比一的商品图完整可见（详情页看全图比填满更重要，
   与首页 aspectFill 裁切的取舍不同——那里是列表要整齐，这里是主图要看全）。 */
.gallery {
  width: 100%;
  height: var(--ws-gallery-h);
  background: var(--ws-surface);
}

.gallery-image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 标题：详情主标用衬线大号，读作"刊物的标题"而不是"列表项的名字" */
.detail__head {
  padding-top: var(--ws-space-card);
}

.detail__title {
  display: block;
  font-family: var(--ws-font-serif);
  font-size: var(--ws-f-xl);
  line-height: var(--ws-lh-tight);
  color: var(--ws-ink);
}

.detail__tag {
  margin-top: var(--ws-space-inline);
}

/* M-02：产地 / 匠人与「为什么值得买」——与 ws-pick-card 同一组 token（组件样式隔离，类不能直接复用） */
.detail__maker {
  display: block;
  margin-bottom: var(--ws-space-tight);
  font-size: var(--ws-f-caption);
  color: var(--ws-ink-mute);
  letter-spacing: var(--ws-ls-display);
}

.detail__why {
  margin: var(--ws-space-inline) 0;
  padding: var(--ws-space-inline) var(--ws-space-stack);
  border-left: var(--ws-rule-accent) solid var(--ws-accent);
  background: var(--ws-surface-sunk);
  border-radius: 0 var(--ws-radius-sm) var(--ws-radius-sm) 0;
}

.detail__why-label {
  display: block;
  font-size: var(--ws-f-caption);
  color: var(--ws-accent-deep);
  letter-spacing: var(--ws-ls-wide);
}

.detail__why-text {
  display: block;
  margin-top: var(--ws-space-tight);
  font-size: var(--ws-f-sm);
  line-height: var(--ws-lh-body);
  color: var(--ws-ink-soft);
}

/* 编辑标签 / 保障标签：横排可换行 */
.detail__tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--ws-space-inline);
}

.detail__tags .ws-tag {
  margin: 0 var(--ws-space-hair) var(--ws-space-hair) 0;
}

/* M-03：购买保障逐条 */
.assure {
  padding: var(--ws-space-inline) 0;
  border-bottom: var(--ws-border-width) solid var(--ws-line);
}

.assure__tag {
  display: block;
  color: var(--ws-ink);
}

/* M-03：运输流程分段（左序号、右说明） */
.step {
  display: flex;
  align-items: flex-start;
  padding: var(--ws-space-inline) 0;
}

.step__no {
  flex: none;
  margin-right: var(--ws-space-inline);
}

.step__body {
  flex: 1;
  min-width: 0;
}

.step__title {
  display: block;
  color: var(--ws-ink);
}

/* 规格表：左侧窄标签、右侧值，行间用发丝线分隔 */
.specs {
  margin-top: var(--ws-space-card);
  border-top: var(--ws-border-width) solid var(--ws-line);
}

.spec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--ws-space-inline) 0;
  border-bottom: var(--ws-border-width) solid var(--ws-line);
}

.spec__k {
  flex: none;
  margin-right: var(--ws-space-stack);
}

.spec__v {
  text-align: right;
  word-break: break-all;
}

/* 换算价跟在日元价后面：留一点空，不粘在"円"上 */
.detail__sub-price {
  margin-left: var(--ws-space-hair);
}

/* A10（AJ-416）：同类推荐——两列小卡（48% 宽 + 两列间留缝，不用 gap：基础库支持不一致） */
.related {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.related__item {
  width: 48%;
  margin-top: var(--ws-space-inline);
}

.related__title {
  display: block;
  margin-top: var(--ws-space-hair);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* A9（AJ-416）：数量行（与购物车的步进同尺寸：触控区 ≥ --ws-touch-min） */
.qty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--ws-space-stack);
}

.qty-row__ctl {
  display: flex;
  align-items: center;
}

/* MP-12（第二轮审计 2026-10-11）：原名 .step，与上方"运输流程"的 .step 同名——本条在后，覆盖了流程行的
   align-items 并加上居中 / 触控下限 / 大字号。改名后两处互不影响（样式值本身不动）。 */
.qty-step {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: var(--ws-touch-min);
  min-height: var(--ws-touch-min);
  color: var(--ws-ink);
  font-size: var(--ws-f-lg);
}

.qty-row__value {
  padding: 0 var(--ws-space-inline);
  color: var(--ws-ink);
  font-size: var(--ws-f-base);
}

/* M-13（AJ-406）：底部固定购买栏。
   @why 栏高走 --ws-buybar-h（页面留白 `.ws-page--with-buybar` 用同一个 token），安全区单独加在内边距里，
        所以 iPhone 底部手势条不会压住按钮。 */
.buy-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 var(--ws-space-gutter) env(safe-area-inset-bottom);
  background: var(--ws-surface);
  border-top: var(--ws-border-width) solid var(--ws-line);
  box-shadow: var(--ws-shadow-float);
  z-index: 900;
}

.buy-bar__note {
  display: block;
  padding-top: var(--ws-space-hair);
}

.buy-bar__row {
  display: flex;
  align-items: center;
  min-height: var(--ws-buybar-h);
}

.buy-bar__info {
  flex: none;
  margin-right: var(--ws-space-inline);
}

/* 购物车入口：次要的文字动作，高度 56rpx（约 28pt）——**未达** 44pt：栏高只有 112rpx，
   价格 + 88rpx 的入口会把栏撑高、多遮一截内容。主要动作（两个按钮）满足 44pt（M-19）；
   这一处是取舍，记在 AJ-406，真机手感不行再改成整列可点。 */
.buy-bar__cart {
  display: flex;
  align-items: center;
  min-height: var(--ws-space-section);
  color: var(--ws-ink-soft);
  font-size: var(--ws-f-sm);
}

.buy-bar__btn {
  flex: 1;
  min-width: 0;
}

.buy-bar__btn + .buy-bar__btn {
  margin-left: var(--ws-space-hair);
}

/* 加载 / 错误态 */
.state {
  text-align: center;
}

.state__error {
  color: var(--ws-danger);
}
