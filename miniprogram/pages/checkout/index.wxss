/**
 * 确认订单页样式（S3 已切到设计体系基础类）。
 *
 * ⚠️ 颜色与尺寸一律走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件，
 * 硬编码色值 / 非 0 尺寸字面量直接红）。
 *
 * @why 报价区的类名（`.quote-line` / `.total`）与购物车页**刻意重名不复制**：
 *      两页共用同一套报价视觉，改一处即两处（design token 的本意）。
 *      ⚠️ 不用全局 `.row`：app.wxss 里有一个同名的基础类（padding 8rpx），
 *         页面类覆盖它会让"全局基础类被悄悄改掉"，且只在这一页生效。
 */

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--ws-space-hair) 0;
}

/* A6：缩略图——与订单列表同宽（18%），比购物车小：这里只是"认一下是哪件"，不是逛 */
.item__thumb {
  width: 18%;
  flex: none;
  margin-right: var(--ws-space-inline);
}

/* 标题在上、单价与数量在下（主流确认页的商品行） */
.item__info {
  flex: 1;
  min-width: 0;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item__meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: var(--ws-space-hair);
}

.item__title {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item__qty {
  flex: none;
  margin-left: var(--ws-space-inline);
}

/* 地址卡：左边内容、右边「›」 */
.addr {
  display: flex;
  align-items: center;
}

.addr__body {
  flex: 1;
  min-width: 0;
}

.addr__go {
  flex: none;
  margin-left: var(--ws-space-inline);
  font-size: var(--ws-f-lg);
}

.addr__add {
  color: var(--ws-accent);
}

/* 地址行 */
.line {
  display: block;
  margin-top: var(--ws-space-hair);
}

.hint {
  display: block;
  margin-top: var(--ws-space-inline);
}

/* 报价明细 */
.quote-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--ws-space-hair) 0;
}

.total__rule {
  margin: var(--ws-space-inline) 0;
}

/* M-16：扣款币种预告——与报价副行同一档字号，上方留一点距离，读作"合计的补充说明" */
.charge-preview {
  margin-top: var(--ws-space-inline);
}

.charge-preview__line {
  display: block;
}

.total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

/* 表单 */
.field__label {
  display: block;
  margin-bottom: var(--ws-space-hair);
}

/* CPY-015：邮箱用途说明常驻在 label 下（收集时就要说清用在哪）。
   @limitation 用 `.ws-note` 而非 `.ws-caption`：这行是**要读的说明**，取较大字号（note 24rpx / caption 22rpx）。
      ⚠️ 二者自 UX-002（204b53a）起同走 --ws-ink-readable（白底过 AA），仅字号分档——
         原注释写的「caption 是 --ws-ink-faint、白底 2.18:1」是 UX-002 落地前的旧由，现已不成立。 */
.field__purpose {
  display: block;
  margin-bottom: var(--ws-space-hair);
}

.input {
  display: block;
  padding: var(--ws-space-inline) var(--ws-space-stack);
  border: var(--ws-border-width) solid var(--ws-line);
  border-radius: var(--ws-radius-sm);
  background: var(--ws-surface-sunk);
  color: var(--ws-ink);
  font-size: var(--ws-f-base);
}

/* 占位符：比正文弱一档（--ws-ink-faint），让"示例"和"已填"一眼可分。
   ⚠️ 本页原先没有 `.ph`——`placeholder-class` 指向的类不存在等于没写，占位与真填同色同重。
      @why 不自创色值：与 `pages/address-edit/index.wxss` 同一口径，本页若另起一个"弱多少"
           的标准，占位符在全站就有两档不同的分量。
   @limitation `.input` / `.ph` 至今仍是逐页各抄一份、`app.wxss` 里没有——下沉要牵动全站样式，
               不在本次改动里（本次只把结算页补齐到与地址页同一口径）。 */
.ph {
  color: var(--ws-ink-faint);
}

/* 条款勾选：整行可点（用 view 不是 button——页面不允许原生可点 button） */
.terms {
  /* M-19（AJ-406）：条款勾选是提交前必经的一点，触控高度 ≥ --ws-touch-min */
  display: flex;
  align-items: center;
  min-height: var(--ws-touch-min);
}

/* "查看条款全文"：整行可点（同上，用 view） */
.act {
  /* M-19：文字动作触控高度 ≥ --ws-touch-min，字号提到正文 */
  display: flex;
  align-items: center;
  min-height: var(--ws-touch-min);
  color: var(--ws-accent);
  font-size: var(--ws-f-base);
}

/* 空态 / 错误 */
.state {
  text-align: center;
}

.state__error {
  color: var(--ws-danger);
}
