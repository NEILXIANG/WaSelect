/**
 * 确认订单页样式。
 *
 * ⚠️ 颜色与尺寸一律走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件，
 * 硬编码色值 / 非 0 尺寸字面量直接红）。
 * ⚠️ 类与购物车页重复的（.row/.total/.sub-price）刻意重名不复制——
 *    两页共用同一套报价区视觉，改一处即两处（design token 的本意）。
 */

.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.qty {
  color: var(--ws-color-muted);
  font-size: var(--ws-font-sm);
}

.line {
  display: block;
  margin-top: var(--ws-space-sm);
  color: var(--ws-color-fg);
  font-size: var(--ws-font-sm);
}

.hint {
  display: block;
  margin-top: var(--ws-space-sm);
  color: var(--ws-color-muted);
  font-size: var(--ws-font-sm);
}

.total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: var(--ws-space-sm);
}

.sub-price {
  display: block;
  margin-top: var(--ws-space-sm);
  color: var(--ws-color-muted);
  font-size: var(--ws-font-sm);
}

/* 条款勾选：整行可点（用 view 不是 button——页面不允许原生可点 button） */
.terms {
  padding: var(--ws-space-sm) 0;
}

.tip {
  display: block;
  margin-top: var(--ws-space-sm);
  text-align: center;
}
