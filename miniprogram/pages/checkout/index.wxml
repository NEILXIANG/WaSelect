<!--
  确认订单（I2）：商品行 + 收货地址 + 权威报价 + 条款 → 建单 → 支付页。

  ⚠️ 商品行**没有价格**：价格只信 POST /orders/quote（行里一有价格就会有人拿它算合计，
  而购物车快照价会过期）。@see index.vm.js @limitation 一

  ⚠️ 提交按钮禁用时**必须显示原因**（gate.reason）——禁用不说为什么会被读成"这站坏了"。
-->
<view class="page">
  <view class="card" wx:if="{{error}}">
    <text class="error">{{error}}</text>
  </view>

  <view class="card" wx:if="{{rows.length > 0}}">
    <view class="row" wx:for="{{rows}}" wx:key="productId">
      <text class="label">{{item.title}}</text>
      <text class="qty">× {{item.qty}}</text>
    </view>
  </view>

  <view class="card" wx:else>
    <text class="label">购物车是空的</text>
  </view>

  <view class="card" bindtap="onPickAddress">
    <text class="label">收货地址</text>
    <block wx:if="{{address}}">
      <text class="line">{{address.recipient}} · {{address.phone}}</text>
      <text class="line">{{address.line1}}</text>
      <text class="line" wx:if="{{address.line2}}">{{address.line2}}</text>
      <text class="line">{{address.region}}</text>
    </block>
    <text class="line" wx:else>还没有地址，点这里新增</text>
    <text class="hint">点此切换地址</text>
  </view>

  <view class="card" wx:if="{{quote}}">
    <view class="row" wx:for="{{quote.lines}}" wx:for-item="line" wx:key="label">
      <text class="label">{{line.label}}</text>
      <text class="value">{{line.value}}</text>
    </view>

    <view class="total">
      <text class="label">应付合计</text>
      <ws-price wx:if="{{quote.hasTotal}}" jpy="{{quote.totalJpy}}" size="lg" />
    </view>
    <text class="sub-price" wx:if="{{quote.totalSub}}">{{quote.totalSub}}</text>
    <text class="label" wx:for="{{quote.hints}}" wx:for-item="hint" wx:key="*this">{{hint}}</text>
  </view>

  <view class="card" wx:if="{{loading}}">
    <text class="label">正在计算运费…</text>
  </view>

  <!-- 收货通知邮箱（选填，PRD §3 / D-39；AJ-180）：微信内没有推送兜底，发货通知靠它 -->
  <view class="card">
    <text class="label">收货通知邮箱（选填）</text>
    <input
      class="input"
      type="text"
      value="{{email}}"
      placeholder="用于接收发货通知，可留空"
      maxlength="255"
      bindinput="onEmailInput"
    />
    <text class="error" wx:if="{{emailError}}">{{emailError}}</text>
  </view>

  <view class="card">
    <view class="terms" bindtap="onToggleTerms">
      <text class="label">{{termsAccepted ? '✓ 已阅读并同意购买条款' : '阅读并同意购买条款'}}</text>
    </view>
    <text class="hint" wx:if="{{termsVersion}}">条款版本 {{termsVersion}}</text>
    <!--
      MP3-11：取不到条款时**不写"加载中"**。闸门此时已经在按钮上方写着
      "购买条款暂时取不到，请稍后再试"，这一行再说"加载中"就是同屏两种相反的说法
      （一个说失败了、一个说还在来），而它永远不会变成别的字。
    -->
    <text class="hint" wx:elif="{{!termsFailed}}">条款版本加载中</text>
    <!--
      ⚠️ 勾选框必须配一个"能真的读到条款"的去处：只有勾选没有正文，
      等于让用户同意一份他看不见的文本（我们手上却会有一份"已同意"的记录）。
    -->
    <view class="act" bindtap="onOpenTerms">查看条款全文</view>
  </view>

  <ws-button
    text="{{submitting ? '提交中…' : '提交订单'}}"
    type="primary"
    disabled="{{!gate.ok || submitting}}"
    loading="{{submitting}}"
    bindtap="onSubmit"
  />
  <text class="label tip" wx:if="{{gate.reason}}">{{gate.reason}}</text>
</view>
