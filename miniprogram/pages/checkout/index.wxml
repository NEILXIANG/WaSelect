<!--
  确认订单（I2）：商品行 + 收货地址 + 权威报价 + 条款 → 建单 → 支付页。

  S3（2026-10-02）：版式换成设计体系（`.ws-*` 基础类），信息架构与行为不动。

  ⚠️ 商品行**不带价格数字**：价格只信 POST /orders/quote（行里一有价格就会有人拿它算合计，
  而购物车快照价会过期）。行上的单价文字取自报价 lines（rowsWithQuotePrice）。@see index.vm.js @limitation 一

  ⚠️ 提交按钮禁用时**必须显示原因**（gate.reason）——禁用不说为什么会被读成"这站坏了"。

  样式只走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件对应的 wxss）。
-->
<view class="ws-page {{rows.length > 0 ? 'ws-page--with-buybar' : ''}} checkout">
  <!-- P2-38：错误态给"重新加载"（重取条款 / 地址 / 报价；不会重复下单——建单只由「提交订单」触发） -->
  <ws-state-block
    wx:if="{{error}}"
    kind="fail"
    title="有一步没有完成"
    reason="{{error}}"
    refText="{{errorRef}}"
    actionText="{{productGone ? goneActionText : errorContact ? '联系客服' : '重新加载'}}"
    compact="{{true}}"
    bindaction="onRetry"
  />

  <!--
    全入口点击测试 2026-10-11：地址卡挪到最上面、右侧加「›」——主流确认页（京东 / 淘宝 / 拼多多）都是地址在首位：
    它是买家唯一必须操作的一项，原先排在商品后面，新用户要往下找；没有地址时用强调色"＋ 新增收货地址"，原先一行灰字看不出能点。
  -->
  <view class="ws-gutter ws-section">
    <view class="ws-card addr" hover-class="ws-press" bindtap="onPickAddress">
      <view class="addr__body">
        <text class="ws-section-kicker">收货地址</text>
        <block wx:if="{{address}}">
          <text class="ws-body line">{{address.recipient}} · {{address.phone}}</text>
          <text class="ws-body line">{{address.line1}}</text>
          <text class="ws-body line" wx:if="{{address.line2}}">{{address.line2}}</text>
          <text class="ws-body line">{{address.region}}</text>
        </block>
        <!-- F5（第二轮审计）：取失败 ≠ 没有地址——说"没取到"，不引导用户再新增一条 -->
        <!-- 两端逐页走查第三轮：账号受限时不叫人去点"重新加载"（上方只有「联系客服」；vm addressFailedText） -->
        <text class="ws-note line" wx:elif="{{addressFailed}}">{{addressFailedText}}</text>
        <text class="ws-body line addr__add" wx:else>＋ 新增收货地址</text>
        <!-- 走查 2026-10-08：没有地址时上一行已经说"添加"，再写"切换地址"是自相矛盾 -->
        <text class="ws-caption hint" wx:if="{{address}}">点此切换地址</text>
      </view>
      <text class="ws-note addr__go" wx:if="{{!addressFailed}}">›</text>
    </view>
  </view>

  <view class="ws-gutter ws-section" wx:if="{{rows.length > 0}}">
    <view class="ws-card">
      <text class="ws-section-kicker">商品</text>
      <view class="item" wx:for="{{rows}}" wx:key="productId">
        <!-- A6（AJ-416）：缩略图（外层管宽度、里层管正方形，@see media-square.unit.test.ts） -->
        <view class="item__thumb">
          <view class="ws-media ws-media--square">
            <image wx:if="{{item.image}}" class="ws-media__img" src="{{item.image}}" mode="aspectFill" lazy-load webp="{{true}}" />
          </view>
        </view>
        <!-- 全入口点击测试 2026-10-11：单价来自报价（rowsWithQuotePrice），报价没回来时不显示 -->
        <view class="item__info">
          <text class="ws-body item__title">{{item.title}}</text>
          <view class="item__meta">
            <text class="ws-body item__price">{{item.priceText}}</text>
            <text class="ws-note item__qty">× {{item.qty}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="ws-gutter ws-section" wx:else>
    <view class="ws-card state">
      <text class="ws-note">{{emptyText}}</text>
      <ws-button text="{{emptyAction === 'cart' ? '回购物车' : '去逛逛'}}" type="default" bindtap="onGoShopping" />
    </view>
  </view>

  <view class="ws-gutter ws-section" wx:if="{{quote}}">
    <view class="ws-card">
      <text class="ws-section-kicker">费用明细</text>
      <view class="quote-line" wx:for="{{quote.lines}}" wx:for-item="line" wx:key="label">
        <text class="ws-note">{{line.label}}</text>
        <text class="ws-body">{{line.value}}</text>
      </view>

      <view class="ws-hair total__rule" />

      <view class="total">
        <text class="ws-note">应付合计</text>
        <ws-price wx:if="{{quote.hasTotal}}" jpy="{{quote.totalJpy}}" size="lg" />
      </view>
      <text class="ws-note line-block" wx:if="{{quote.totalSub}}">{{quote.totalSub}}</text>
      <text class="ws-caption line-block" wx:for="{{quote.hints}}" wx:for-item="hint" wx:key="*this">{{hint}}</text>
      <!-- AJ-489：挡住提交的原因用错误色单独一行（原混在灰色说明里） -->
      <text class="ws-note state__error line-block" wx:if="{{quote.blocker}}">{{quote.blocker}}</text>
      <!-- M-16（AJ-406）：扣款币种预告——円为主显示（AJ-402 Q3），银行卡以美元扣；金额来自报价 display，写"约" -->
      <view class="charge-preview" wx:if="{{chargePreview.length > 0}}">
        <text class="ws-note charge-preview__line" wx:for="{{chargePreview}}" wx:for-item="line" wx:key="*this">{{line}}</text>
      </view>
    </view>
  </view>

  <view class="ws-gutter" wx:if="{{loading}}">
    <view class="ws-card state">
      <text class="ws-note">正在计算运费…</text>
    </view>
  </view>

  <!--
    联系邮箱（PRD §3 / D-39；AJ-180）。M-01（AJ-405 / AJ-402 Q1）起**前端必填**：
    订阅消息未开通，邮件是付款 / 发货 / 退款通知的唯一渠道；契约与服务端仍可选。
    没填时提交按钮下方由闸门说明原因（与其余各项同一处），输入框下只在用户动过之后提示。
    ⚠️ AJ-295：这里**曾经**叫"收货通知邮箱"、placeholder 写"用于接收发货通知"——
       但通知链路（MAIL_* / SUBSCRIBE_TMPL_*）全库无使用方，那是一句**不成立的承诺**：
       用户是照着"会收到发货通知"才留下邮箱的。
    复核 2026-10-06：AJ-369 已上线订单邮件（付款 / 发货 / 退款），用途说明随之改回——
       收集时告知的利用目的要与实际一致（APPI），少说同样是不一致。
  -->
  <view class="ws-gutter ws-section" id="contact-email">
    <view class="ws-card">
      <text class="ws-section-kicker">联系方式</text>
      <text class="ws-note field__label">联系邮箱（必填）</text>
      <input
        class="input"
        type="text"
        value="{{email}}"
        placeholder="接收付款、发货、退款邮件，订单有问题时也用它联系你"
        maxlength="255"
        bindinput="onEmailInput"
        bindblur="onEmailBlur"
      />
      <text class="ws-note state__error" wx:if="{{emailError}}">{{emailError}}</text>
      <!-- MP-9（第二轮审计）：常见拼错提示，只提示不拦（gmial.com / .con …） -->
      <text class="ws-body" wx:if="{{emailHint}}">{{emailHint}}</text>
    </view>
  </view>

  <view class="ws-gutter ws-section">
    <view class="ws-card">
      <view
        class="terms"
        hover-class="ws-press"
        bindtap="onToggleTerms"
        aria-role="checkbox"
        aria-checked="{{termsAccepted}}"
        aria-label="阅读并同意用户协议"
      >
        <!-- A5（AJ-416）：未勾选也画出框——原先未勾选只有一行字，看不出这是能点的勾选框 -->
        <text class="ws-body">{{termsAccepted ? '☑ 我已阅读并同意用户协议' : '☐ 我已阅读并同意用户协议'}}</text>
      </view>
      <!-- F6（第二轮审计）：条款就绪失败（如没有条款地址）时不显示版本号——看起来"就绪"、其实下不了单 -->
      <text class="ws-caption hint" wx:if="{{termsVersion && !termsFailed}}">条款版本 {{termsVersion}}</text>
      <!--
        MP3-11：取不到条款时**不写"加载中"**。闸门此时已经在按钮上方写着
        "用户协议暂时取不到，请稍后再试"，这一行再说"加载中"就是同屏两种相反的说法
        （一个说失败了、一个说还在来），而它永远不会变成别的字。
      -->
      <text class="ws-caption hint" wx:elif="{{!termsFailed}}">条款版本加载中</text>
      <!--
        ⚠️ 勾选框必须配一个"能真的读到条款"的去处：只有勾选没有正文，
        等于让用户同意一份他看不见的文本（我们手上却会有一份"已同意"的记录）。
      -->
      <view class="act" hover-class="ws-press" bindtap="onOpenTerms">查看用户协议全文</view>
    </view>
  </view>

  <!-- 剩余清单 4-10：付款前说清"采购不到会整单全额退款" -->
  <view class="ws-gutter ws-section">
    <text class="ws-note">{{stockRefundNote}}</text>
  </view>

  <!--
    A2（AJ-416）：合计 + 提交订单固定在底部——原先要滑过商品、地址、合计、邮箱、条款才看得到按钮。
    禁用原因（gate.reason）放在栏的最上方一行，紧挨按钮（禁用不说为什么会被读成"这站坏了"）。
    ⚠️ 禁用的**唯一判据是 gate**（体验审查 2026-10-15，P2-8）：原先这里还写着 `|| loading`，
       而"重算在途"进不了闸门 ⇒ 按钮灰着、原因行却是空的；现在它已是闸门的一档
       （`submitGate` 的 `refreshing`），两边同源。
    合计只用权威报价（quote.hasTotal），没出来时显示"—"。没有商品时不出栏（空态卡片里有"去逛逛"）。
  -->
  <view class="ws-buybar" wx:if="{{rows.length > 0}}">
    <!-- MP-6（第二轮审计）：功能性提示用可读字色（app.wxss `.ws-caption.ws-buybar__note`），不用最浅的 caption 色 -->
    <text class="ws-caption ws-buybar__note" wx:if="{{gate.reason}}">{{gate.reason}}</text>
    <view class="ws-buybar__row">
      <view class="ws-buybar__sum">
        <text class="ws-note ws-buybar__label">应付</text>
        <ws-price wx:if="{{quote && quote.hasTotal}}" jpy="{{quote.totalJpy}}" size="md" />
        <text class="ws-note" wx:else>—</text>
      </view>
      <view class="ws-buybar__btn">
        <ws-button
          text="{{submitting ? '提交中…' : '提交订单'}}"
          type="primary"
          block="{{true}}"
          disabled="{{(!gate.ok && !gate.fix) || submitting}}"
          loading="{{submitting}}"
          bindtap="onSubmit"
        />
      </view>
    </view>
  </view>
</view>
