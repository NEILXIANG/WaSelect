<!--
  支付（I2）：支付方式由 GET /pay/channels 下发并渲染，**不写死通道名与按钮**
  （ADR-28/F11：上下线一个通道改配置即可，无需发版）。

  S3（2026-10-02）：版式换成设计体系（`.ws-*` 基础类），信息架构与行为不动。

  ⚠️ 按钮文案取自服务端的 `label`（外置文案）；entryMode 为 redirect 的通道
  在 utils/pay-plan.js 里就被滤掉了——小程序内没有"302 跳出去再回来"的闭环，
  显示了就是"点了没反应"。

  ⚠️ copylink 那一屏：只给"复制链接"，不自动复制、不代为跳转
  （剪贴板是用户的东西；跳出去也打不开——D-49 已废 web-view）。

  样式只走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件对应的 wxss）。
-->
<view class="ws-page pay">
  <view class="ws-gutter" wx:if="{{error}}">
    <view class="ws-card state">
      <text class="ws-note state__error">{{error}}</text>
      <text class="ws-caption" wx:if="{{errorRef}}" user-select>{{errorRef}}</text>
      <!-- 剩余清单 4-8：错误态给出下一步（原先只有一行红字） -->
      <ws-button text="重试" type="default" bindtap="onRetry" />
    </view>
  </view>

  <!-- 剩余清单 4-8：可付的单却没有任何可用支付方式（金额 / 地区不支持） -->
  <ws-state-block
    wx:if="{{noChannel}}"
    kind="empty"
    title="暂时没有可用的支付方式"
    reason="这笔订单的金额或收货地区暂不支持在线支付。可以稍后重试，或在「我的」里联系客服"
    actionText="重试"
    bindaction="onRetry"
  />

  <!--
    MP3-07：`payResult` 是"上一次支付动作"的结论，不随整页重取清空。
    @why 拉起微信收银台会让平台触发 onHide → onShow → 整页重取，
         而重取开头会清 `error`——把取消提示放那儿，用户永远看不到它。
  -->
  <view class="ws-gutter" wx:if="{{confirmNote}}">
    <text class="ws-note">{{confirmNote}}</text>
  </view>
  <view class="ws-gutter" wx:if="{{payResult}}">
    <view class="ws-card state">
      <text class="ws-note state__error">{{payResult}}</text>
    </view>
  </view>

  <view class="ws-gutter" wx:if="{{loading}}">
    <view class="ws-card state">
      <text class="ws-note">正在加载支付方式…</text>
    </view>
  </view>

  <!--
    MP3-11：关单屏（已付款 / 已退款 / 已超时）把这一行的标签从「应付合计」改成「订单合计」。
    @why 单已经付过了（或根本没付成），"应付"两个字是错的——用户会读成"我还要再付这么多"。
         金额本身留着：它是用户核对"付了多少钱"的凭据，收掉反而更糟。
  -->
  <!-- 剩余清单 4-11（A24）：待付款倒计时 -->
  <view class="ws-gutter" wx:if="{{countdown}}">
    <text class="ws-note">{{countdown}}</text>
  </view>

  <view class="ws-gutter ws-section" wx:if="{{totalJpy !== null}}">
    <view class="ws-card">
      <text class="ws-section-kicker">{{closedText ? 'Order Total' : 'Amount Due'}}</text>
      <view class="total">
        <text class="ws-note">{{closedText ? '订单合计' : '应付合计'}}</text>
        <ws-price jpy="{{totalJpy}}" size="lg" />
      </view>
    </view>
  </view>

  <!-- §14.2 支付前明确提示（官方运营规范强制，D-48 / AJ-180）：必须在支付按钮**上方**、点之前就看得到 -->
  <view class="ws-gutter ws-section notice" wx:if="{{notice.length > 0}}">
    <view class="ws-card">
      <text class="ws-section-kicker">Before You Pay</text>
      <text class="ws-title notice__title">支付前请确认</text>
      <text class="ws-body line" wx:for="{{notice}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!--
    B35 / AJ-218：订单已经不需要再支付（已付 / 已发货… / 已退款）时**不给支付方式**。
    以前这一屏完全不看状态，从返回栈回到已付单照样列出通道，点下去是 40902——
    在"支付"这个动作上遇到它，用户第一反应是"刚才是不是没付成功"。
  -->
  <view class="ws-gutter ws-section" wx:if="{{closedText}}">
    <view class="ws-card">
      <text class="ws-body">{{closedText}}</text>
      <!--
        MP3-01：只有"没付成"才有这个按钮（expired / cancelled）。
        文案说了"如需购买请重新下单"却没地方可点，等于把人丢在死胡同里；
        而这一屏是支付流程的终点，下面只有一个"查看订单"——他要的是买，不是看。
      -->
      <view class="cta-inner" wx:if="{{goHome}}">
        <ws-button text="去首页重新下单" type="primary" bindtap="onGoHome" />
      </view>
    </view>
  </view>

  <view class="ws-gutter ws-section" wx:if="{{channels.length > 0}}">
    <view class="ws-card">
      <text class="ws-section-kicker">Payment Method</text>
      <!--
        AJ-431：支付方式是按钮（第一个实心、其余描边，档位由 vm 的 buttonType 给）。
        原先是卡片里的一行字，页面唯一的实心按钮是「查看订单」，买家会去点它而没付款。
        走 ws-button 也让"付款"这一下有了组件的连点防线（页面另有 payStartDecision 挡在途重复发起）。
        data-channel 写在组件宿主上，页面 onPay 从 e.currentTarget.dataset 读。
        @measured 2026-10-10 开发者工具模拟器：对 #pay-mock 调组件的 onTap（真实 triggerEvent 链路）→
                  页面 onPay 拿到 channel，订单变为 status=paid、payment.channel=mock。
        id 供自动化选中（自动化选不到组件标签名）。
      -->
      <view class="channel" wx:for="{{channels}}" wx:key="channel">
        <ws-button
          id="pay-{{item.channel}}"
          text="{{item.buttonText}}"
          type="{{item.buttonType}}"
          block
          data-channel="{{item.channel}}"
          bindtap="onPay"
        />
      </view>
    </view>
  </view>

  <view class="ws-gutter" wx:if="{{paying}}">
    <view class="ws-card state">
      <text class="ws-note">正在发起支付…</text>
    </view>
  </view>

  <!-- 引导屏：copylink（银行卡）/ auto（审核期）/ unsupported -->
  <view class="ws-gutter ws-section" wx:if="{{guide.title}}">
    <view class="ws-card">
      <text class="ws-title">{{guide.title}}</text>
      <text class="ws-body line">{{guide.body}}</text>
      <!-- 剩余清单 4-11（A37）：银行卡三步图示 -->
      <view class="steps" wx:if="{{guide.steps.length > 0}}">
        <view class="step-row" wx:for="{{guide.steps}}" wx:key="*this">
          <text class="ws-note">{{index + 1}}. {{item}}</text>
        </view>
      </view>
      <!--
        B34 / AJ-217：链接**本身**要可见可选。`setClipboardData` 是隐私接口，会失败
        （用户拒绝弹窗 / 隐私指引漏声明剪切板），失败时用户唯一的出路就是长按这里手动复制。
        不把它渲染出来的话，"复制失败"这四个字等于一句没有出路的通知。
      -->
      <text class="ws-caption url" user-select wx:if="{{payUrl}}">{{payUrl}}</text>
      <view class="cta-inner" wx:if="{{payUrl}}">
        <ws-button
          text="{{copied ? '已复制' : '复制链接'}}"
          type="primary"
          bindtap="onCopy"
        />
      </view>
    </view>
  </view>

  <!-- 订单列表随时可去：支付完成的真值在那里（服务端回调落库），不在本页 -->
  <view class="ws-gutter ws-section cta">
    <!-- A1（2026-10-09）：去浏览器付款后的手动出口；只在短链屏出现（那是唯一会"付了但这里还不知道"的路径） -->
    <ws-button
      wx:if="{{payUrl && !closedText}}"
      text="我已付款，刷新状态"
      type="default"
      bindtap="onRefreshPaid"
    />
    <!-- AJ-431：页面上有更该做的事（付款 / 重新下单 / 复制链接）时描边，否则实心——每屏只留一个实心主按钮 -->
    <ws-button
      text="查看订单"
      type="{{channels.length > 0 || goHome || payUrl ? 'default' : 'primary'}}"
      bindtap="onViewOrders"
    />
  </view>
</view>
