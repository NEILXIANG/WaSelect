/**
 * 支付页样式。
 *
 * ⚠️ 颜色与尺寸一律走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件，
 * 硬编码色值 / 非 0 尺寸字面量直接红）。
 */

.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

/* 支付方式条目：整行可点（用 view 不是 button——页面不允许原生可点 button） */
.channel {
  padding: var(--ws-space-sm) 0;
  border-bottom: var(--ws-border-width) solid var(--ws-color-muted);
}

.line {
  display: block;
  margin-top: var(--ws-space-sm);
  color: var(--ws-color-muted);
  font-size: var(--ws-font-sm);
}

.tip {
  display: block;
  margin-top: var(--ws-space-sm);
  text-align: center;
}

/* §14.2 提示条：与普通卡片区分（强调边），颜色走 token */
.notice {
  border-left: var(--ws-border-width) solid var(--ws-color-fg);
}

/*
  短链文本：必须能整段显示 + 长按可选（B34 / AJ-217 的兜底动作）。
  @why 短链通常比屏宽长，不折行会被截断——被截断的链接复制出去是坏的，
       而这个"看起来复制成功了、粘贴出来打不开"的失败比直接失败更难发现。
*/
.url {
  word-break: break-all;
}
