/**
 * 订单列表页样式（S3 已切到设计体系基础类）。
 *
 * ⚠️ 颜色与尺寸一律走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件，
 * 硬编码色值 / 非 0 尺寸字面量直接红）。
 */

.order__list {
  padding-top: var(--ws-space-card);
}

.order-card {
  margin-bottom: var(--ws-space-stack);
}

.order-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-card__no {
  flex: 1;
  min-width: 0;
}

/* 状态标签：用基础类 `.ws-tag` 的底与字色，不再单独引色值——
   "订单状态"是标签语义，就该长成标签的样子，与其他标签同族。 */
.order-card__status {
  flex: none;
  margin-left: var(--ws-space-inline);
}

.order-card__amount {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: var(--ws-space-inline);
}

/* "继续支付"：整行可点（用 view 不是 button——页面不允许原生可点 button） */
.act {
  margin-top: var(--ws-space-inline);
  padding-top: var(--ws-space-inline);
  border-top: var(--ws-border-width) solid var(--ws-line);
  color: var(--ws-accent);
  font-size: var(--ws-f-sm);
  text-align: right;
}

/* 加载 / 错误 / 空态 */
.state {
  text-align: center;
}

.state__error {
  color: var(--ws-danger);
}

/* M-06：状态下一句"下一步会发生什么" */
.order-card__next {
  display: block;
  margin-top: var(--ws-space-hair);
}

/* M-10（AJ-408）：状态页签条——五格等分，当前格用强调色 + 下划线（只走 token） */
.order-tabs {
  display: flex;
  padding-top: var(--ws-space-inline);
  border-bottom: var(--ws-border-width) solid var(--ws-line);
}

.order-tabs__item {
  flex: 1;
  min-height: var(--ws-touch-min);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--ws-f-sm);
  color: var(--ws-ink-mute);
  border-bottom: var(--ws-hair-thick) solid transparent;
}

.order-tabs__item--active {
  color: var(--ws-ink);
  border-bottom-color: var(--ws-accent);
}

/* M-11（AJ-408）：左缩略图、右件数与下单时间。图宽用百分比（同订单详情 .item__media：token 里没有"缩略图"一档） */
.order-card__body {
  display: flex;
  align-items: center;
  margin-top: var(--ws-space-inline);
}

.order-card__thumb {
  width: 18%;
  flex: none;
}

.order-card__meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: var(--ws-space-inline);
}

/* A8：首件商品名，最多两行（长日文名不撑高卡片） */
.order-card__title {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
