/**
 * 订单列表页样式。
 *
 * ⚠️ 颜色与尺寸一律走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件，
 * 硬编码色值 / 非 0 尺寸字面量直接红）。
 */

.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

/* 状态标签：用 muted 色与订单号区分（不引新色值——token 里没有"警示色"） */
.status {
  color: var(--ws-color-muted);
  font-size: var(--ws-font-sm);
}

.sub-price {
  display: block;
  margin-top: var(--ws-space-sm);
  color: var(--ws-color-muted);
  font-size: var(--ws-font-sm);
}

/* "继续支付"：整行可点（用 view 不是 button——页面不允许原生可点 button） */
.act {
  margin-top: var(--ws-space);
  color: var(--ws-color-fg);
  font-size: var(--ws-font-sm);
}
