<!--
  订单列表（I2）：状态/金额由 vm 给，状态词表与契约 OrderStatus 双向比对（单测钉住）。

  S3（2026-10-02）：版式换成设计体系（`.ws-*` 基础类），信息架构与行为不动。

  ⚠️ 空态只在**确实没有订单**时显示——请求失败时说"还没有订单"会让用户以为订单丢了。

  ⚠️ "继续支付"只出现在 created / pending_payment（vm 的 canPay）：
  这两个态与契约里"可取消"的态刻意一致，避免出现"能付但取消不了"的半开状态。

  样式只走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件对应的 wxss）。
-->
<view class="ws-page ws-page--with-tabbar order">
  <view class="ws-gutter" wx:if="{{loading}}">
    <view class="ws-card state">
      <text class="ws-note">正在加载订单…</text>
    </view>
  </view>

  <!-- P2-38：错误态给"重试"（以前只有一行红字；本页是 tab 页，切走再切回才会重取，用户想不到） -->
  <ws-state-block
    wx:if="{{error}}"
    kind="fail"
    title="没能取到订单"
    reason="{{error}}"
    refText="{{errorRef}}"
    actionText="重试"
    bindaction="onRetry"
  />

  <view class="ws-gutter" wx:if="{{empty}}">
    <view class="ws-card state">
      <text class="ws-note">还没有订单</text>
      <ws-button text="去逛逛" type="default" bindtap="onGoShopping" />
    </view>
  </view>

  <view class="ws-gutter order__list" wx:if="{{rows.length > 0}}">
    <view
      class="ws-card order-card"
      wx:for="{{rows}}"
      wx:key="orderId"
      data-id="{{item.orderId}}"
      hover-class="ws-press"
      bindtap="onRowTap"
    >
      <view class="order-card__head">
        <text class="ws-caption order-card__no">{{item.orderNo}}</text>
        <text class="ws-tag order-card__status">{{item.statusText}}</text>
      </view>
      <!-- M-06（AJ-405）："下一步会发生什么"（vm 给；列表不知道有没有留邮箱，不承诺邮件） -->
      <text class="ws-caption order-card__next" wx:if="{{item.nextText}}">{{item.nextText}}</text>

      <view class="order-card__amount">
        <text class="ws-note">合计</text>
        <ws-price wx:if="{{item.totalJpy !== null}}" jpy="{{item.totalJpy}}" />
      </view>
      <text class="ws-caption" wx:if="{{item.totalSub}}">{{item.totalSub}}</text>

      <!--
        ⚠️ 用 catchtap 不用 bindtap：卡片本身也绑了点击（去详情），
        bindtap 会冒泡到卡片——点"继续支付"会同时跳详情 + 跳支付。
      -->
      <view class="act" wx:if="{{item.canPay}}" data-id="{{item.orderId}}" hover-class="ws-press" catchtap="onPay">
        继续支付
      </view>
    </view>
  </view>
</view>
