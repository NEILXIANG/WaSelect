<!--
  地址编辑（I2）：新增 / 编辑收货地址（美国格式，ASCII）。

  S3（2026-10-02）：版式换成设计体系（`.ws-*` 基础类），**信息架构与行为都不动**。
  S4（2026-10-02）：页头走 `ws-section-head`、七个字段走 `ws-field`、状态走 `ws-state-block`。
                     ⚠️ **一个字段都没加减，字段顺序一个都没动**——换的是容器不是表单。

  ⚠️ 字段顺序**必须**与 `utils/address-form.js` 的 ADDRESS_FIELDS 一致（不只是样式问题：
     顺序在 vm/单测里有断言，动顺序要同步改那边）。
  ⚠️ `data-field` 落白名单外的字段会被 onInput 直接丢弃（防任意字段写进请求体）。

  ⚠️ 校验失败显示**字段级**错误 + 顶部第一条，不弹 toast（页面内文案可测、不依赖宿主时序）。
  服务端拒单也走同一条错误区：前端预检不是权威，只信预检会变成"说对但提交失败"。
-->
<view class="ws-page">
  <ws-section-head
    class="ws-gutter aedit__head"
    kicker="Address"
    title="{{editing ? '编辑地址' : '新增地址'}}"
  />

  <ws-state-block wx:if="{{loading}}" kind="loading" title="正在加载地址" compact="{{true}}" />

  <ws-state-block
    wx:if="{{error}}"
    kind="fail"
    title="没能取到这条地址"
    reason="{{error}}"
    altText="返回列表重开这一页"
    bindalt="onBack"
  />

  <!-- 表单区：S4 起每个字段走 `ws-field`（标签 + 控件 + 错误都在同一个容器里）。
       ⚠️ 错误文案放在 field 的 **slot 里**而不是传给组件：错误长什么样（在输入框下方、
          什么颜色）是这个表单自己的口径，不该由 field 决定（@see 组件 @limitation 二）。 -->
  <view class="ws-gutter">
    <view class="ws-card aedit__form">
      <ws-field label="收件人">
        <input
          class="input"
          value="{{form.recipient}}"
          data-field="recipient"
          bindinput="onInput"
          placeholder="Ken Tanaka"
          placeholder-class="ph"
        />
        <text class="field__error" wx:if="{{errors.recipient}}">{{errors.recipient}}</text>
      </ws-field>

      <ws-field label="电话">
        <input
          class="input"
          value="{{form.phone}}"
          data-field="phone"
          bindinput="onInput"
          placeholder="+14155550123"
          placeholder-class="ph"
        />
        <text class="field__error" wx:if="{{errors.phone}}">{{errors.phone}}</text>
      </ws-field>

      <ws-field label="地址第一行">
        <input
          class="input"
          value="{{form.line1}}"
          data-field="line1"
          bindinput="onInput"
          placeholder="1234 Market St"
          placeholder-class="ph"
        />
        <text class="field__error" wx:if="{{errors.line1}}">{{errors.line1}}</text>
      </ws-field>

      <ws-field label="地址第二行（可留空）">
        <input
          class="input"
          value="{{form.line2}}"
          data-field="line2"
          bindinput="onInput"
          placeholder="Apt 5B"
          placeholder-class="ph"
        />
        <text class="field__error" wx:if="{{errors.line2}}">{{errors.line2}}</text>
      </ws-field>

      <ws-field label="城市">
        <input
          class="input"
          value="{{form.city}}"
          data-field="city"
          bindinput="onInput"
          placeholder="San Francisco"
          placeholder-class="ph"
        />
        <text class="field__error" wx:if="{{errors.city}}">{{errors.city}}</text>
      </ws-field>

      <ws-field label="州（两位大写）">
        <input
          class="input"
          value="{{form.state}}"
          data-field="state"
          bindinput="onInput"
          placeholder="CA"
          placeholder-class="ph"
        />
        <text class="field__error" wx:if="{{errors.state}}">{{errors.state}}</text>
      </ws-field>

      <ws-field label="邮编">
        <input
          class="input"
          value="{{form.postal_code}}"
          data-field="postal_code"
          bindinput="onInput"
          placeholder="94102"
          placeholder-class="ph"
        />
        <text class="field__error" wx:if="{{errors.postal_code}}">{{errors.postal_code}}</text>
      </ws-field>

      <!-- 默认地址开关：整行可点（用 view 不是 button——页面不允许原生可点 button） -->
      <view class="def" hover-class="ws-press" bindtap="onToggleDefault">
        <!-- ⚠️ "✓" 保留字符而不是换成图标：这里是唯一一处勾选表达，
             为它引入图标组件会让"选中/未选中"多一个渲染分支可错。 -->
        <text class="ws-body">{{form.is_default ? '✓ 设为默认地址' : '设为默认地址'}}</text>
      </view>
    </view>
  </view>

  <view class="ws-gutter aedit__foot">
    <ws-button
      text="{{saving ? '保存中…' : '保存'}}"
      type="primary"
      disabled="{{saving}}"
      bindtap="onSave"
    />
    <text class="ws-note tip">收件信息请用英文/数字填写（国际面单不支持中文与全角）</text>
  </view>
</view>
