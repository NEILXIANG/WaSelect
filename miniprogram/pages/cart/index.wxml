<!--
  购物车（I2）：本地条目列表 + 服务端权威报价。

  ⚠️ 行内单价是**加购时的快照**（弱网也能看到购物车长什么样），
  合计**只**来自 POST /orders/quote（cart-store.js @limitation 一：
  拿快照价算钱 = 价格变了没人发现）。行内刻意不显示"小计"——
  小计 = 单价 × 数量，是"算合计"的半成品，同一条红线。

  ⚠️ 去结算按钮当前禁用：目标页 pages/checkout 未落地（@see index.js @limitation 一），
  跳一个不存在的页面 = "看起来能用、实际是坏的"。
-->
<view class="page">
  <view class="card" wx:if="{{empty}}">
    <text class="label">购物车是空的</text>
  </view>

  <block wx:else>
    <view class="card" wx:for="{{rows}}" wx:key="productId">
      <view class="row-item">
        <image class="item-image" src="{{item.image}}" mode="widthFix" lazy-load />
        <view class="item-body">
          <text class="item-title">{{item.title}}</text>
          <text class="item-price" wx:if="{{item.priceText}}">{{item.priceText}}</text>

          <view class="qty">
            <view class="step" data-id="{{item.productId}}" bindtap="onMinus">−</view>
            <text class="qty-value">{{item.qty}}</text>
            <view class="step" data-id="{{item.productId}}" bindtap="onPlus">＋</view>
            <view class="remove" data-id="{{item.productId}}" bindtap="onRemove">删除</view>
          </view>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{quote}}">
      <view class="row" wx:for="{{quote.lines}}" wx:for-item="line" wx:key="label">
        <text class="label">{{line.label}}</text>
        <text class="value">{{line.value}}</text>
      </view>

      <view class="total">
        <text class="label">应付合计</text>
        <ws-price wx:if="{{quote.hasTotal}}" jpy="{{quote.totalJpy}}" size="lg" />
      </view>
      <text class="sub-price" wx:if="{{quote.totalSub}}">{{quote.totalSub}}</text>
      <text class="label" wx:for="{{quote.hints}}" wx:for-item="hint" wx:key="*this">{{hint}}</text>
    </view>

    <view class="card" wx:if="{{quoting}}">
      <text class="label">正在计算运费…</text>
    </view>

    <view class="card" wx:if="{{quoteError}}">
      <text class="error">{{quoteError}}</text>
    </view>

    <!-- 去结算：禁用 + 明示原因（@see index.js @limitation 一） -->
    <ws-button text="去结算" type="primary" disabled="{{true}}" />
    <text class="label checkout-hint">{{checkoutHint}}</text>
  </block>
</view>
