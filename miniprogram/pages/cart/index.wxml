<!--
  购物车（I2）：本地条目列表 + 服务端权威报价。

  S3（2026-10-02）：版式换成设计体系（`.ws-*` 基础类），信息架构与行为不动。

  ⚠️ 行内单价是**加购时的快照**（弱网也能看到购物车长什么样），
  合计**只**来自 POST /orders/quote（cart-store.js @limitation 一：
  拿快照价算钱 = 价格变了没人发现）。行内刻意不显示"小计"——
  小计 = 单价 × 数量，是"算合计"的半成品，同一条红线。

  ⚠️ 去结算只在权威合计出来后才可点：结算页要用它做 expected_total_jpy 防线（40905），
  没有合计就跳过去 = 带着一个"防线已降级"的状态下单，而页面上看不出来。

  样式只走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件对应的 wxss）。
-->
<view class="ws-page {{rows.length > 0 ? 'ws-page--with-tabbar-buybar' : 'ws-page--with-tabbar'}} cart">
  <!-- 全入口点击测试 2026-10-11：原先页顶一张小卡片写"购物车是空的"、下面整屏空白；
       改用全站统一的空状态组件（居中、说明下一步、主按钮），与订单页 / 地址页的空态一致 -->
  <ws-state-block
    wx:if="{{empty}}"
    kind="empty"
    title="购物车还是空的"
    reason="去首页挑几件日本好物，加入购物车后在这里一起结算"
    actionText="去逛逛"
    bindaction="onGoShopping"
  />

  <block wx:else>
    <view class="ws-gutter cart__list">
      <block wx:for="{{rows}}" wx:key="productId">
        <!-- M-14（AJ-406）：删除后在原位置给"撤销"（5 秒，vm undoView），不弹确认框 -->
        <view class="ws-card undo-row" wx:if="{{undo.show && undo.index === index}}">
          <text class="ws-note undo-row__text">{{undo.text}}</text>
          <view class="undo-row__act" hover-class="ws-press" bindtap="onUndo" aria-role="button" aria-label="撤销删除">撤销</view>
        </view>
        <view class="ws-card row-item">
          <view class="row-item__main">
            <!-- A3（AJ-416）：勾选去结算。整块 ≥ 触控下限，点框不会误触到图片跳详情 -->
            <view
              class="pick"
              data-id="{{item.productId}}"
              hover-class="ws-press"
              bindtap="onToggleSelect"
              aria-role="checkbox"
              aria-checked="{{item.selected}}"
              aria-label="{{item.selected ? '取消勾选' : '勾选'}} {{item.title}}"
            >
              <text class="pick__box {{item.selected ? 'pick__box--on' : ''}}">{{item.selected ? '☑' : '☐'}}</text>
            </view>
            <!-- M-14：点图或标题进详情（步进 / 删除是独立点击区，不会误触跳走）；M-18：列表图懒加载 -->
            <!-- 外层管宽度、里层管正方形（padding 百分比按父容器宽度算，@see media-square.unit.test.ts） -->
            <view
              class="row-item__media"
              data-id="{{item.productId}}"
              bindtap="onOpenDetail"
              aria-role="link"
              aria-label="查看 {{item.title}} 详情"
            >
              <view class="ws-media ws-media--square">
                <image wx:if="{{item.image}}" class="ws-media__img" src="{{item.image}}" mode="aspectFill" lazy-load />
              </view>
            </view>
            <view class="row-item__body">
              <text class="ws-title row-item__title" data-id="{{item.productId}}" bindtap="onOpenDetail">{{item.title}}</text>
              <text class="ws-note" wx:if="{{item.priceText}}">{{item.priceText}}</text>
              <!-- 剩余清单 4-7：报价失败时服务端指出的那一件 -->
              <text class="ws-note state__error line-block" wx:if="{{item.invalidText}}">{{item.invalidText}}</text>

              <!-- 数量步进：− / 数量 / ＋ / 删除。
                   ⚠️ 步进块是 view 不是 button：它是"微调"不是"提交动作"，
                   且 page-button-guard 约束的是提交类按钮必须走 ws-button。
                   M-19（AJ-406）：触控区 ≥ 88rpx（约 44pt）；字符图标带 aria-label（读屏不会把"−"念成"减号"了事）。 -->
              <view class="qty">
                <view class="step" data-id="{{item.productId}}" hover-class="ws-press" bindtap="onMinus" aria-role="button" aria-label="减少数量">−</view>
                <text class="qty-value" aria-label="数量 {{item.qty}}">{{item.qty}}</text>
                <view class="step" data-id="{{item.productId}}" hover-class="ws-press" bindtap="onPlus" aria-role="button" aria-label="增加数量">＋</view>
                <view class="remove" data-id="{{item.productId}}" hover-class="ws-press" bindtap="onRemove" aria-role="button" aria-label="删除 {{item.title}}">删除</view>
              </view>
            </view>
          </view>
        </view>
      </block>
      <!-- 删掉的是最后一行（或删光了）：撤销行接在列表末尾 -->
      <view class="ws-card undo-row" wx:if="{{undo.show && undo.index >= rows.length}}">
        <text class="ws-note undo-row__text">{{undo.text}}</text>
        <view class="undo-row__act" hover-class="ws-press" bindtap="onUndo" aria-role="button" aria-label="撤销删除">撤销</view>
      </view>
    </view>

    <view class="ws-gutter ws-section" wx:if="{{quote}}">
      <view class="ws-card">
        <view class="quote-line" wx:for="{{quote.lines}}" wx:for-item="line" wx:key="label">
          <text class="ws-note">{{line.label}}</text>
          <text class="ws-body">{{line.value}}</text>
        </view>

        <view class="ws-hair total__rule" />

        <view class="total">
          <text class="ws-note">应付合计</text>
          <ws-price wx:if="{{quote.hasTotal}}" jpy="{{quote.totalJpy}}" size="lg" />
        </view>
        <text class="ws-note line-block" wx:if="{{quote.totalSub}}">{{quote.totalSub}}</text>
        <text class="ws-caption line-block" wx:for="{{quote.hints}}" wx:for-item="hint" wx:key="*this">{{hint}}</text>
        <!-- AJ-489：挡住提交的原因用错误色单独一行（原混在灰色说明里） -->
        <text class="ws-note state__error line-block" wx:if="{{quote.blocker}}">{{quote.blocker}}</text>
      </view>
    </view>

    <view class="ws-gutter" wx:if="{{quoting}}">
      <view class="ws-card state">
        <text class="ws-note">正在计算运费…</text>
      </view>
    </view>

    <view class="ws-gutter" wx:if="{{quoteError}}">
      <view class="ws-card state">
        <text class="ws-note state__error">{{quoteError}}</text>
        <text class="ws-caption line-block" wx:if="{{quoteErrorRef}}" user-select>{{quoteErrorRef}}</text>
        <!-- M-14：重试可能有用时才给（vm quoteRetryable）；此前只有红字，用户得改一下数量才会重报 -->
        <ws-button wx:if="{{quoteRetry}}" text="重试" type="default" bindtap="onRetryQuote" />
      </view>
    </view>

    <!--
      去结算：只有权威合计出来了才可点（@see index.js @limitation 一）。
      B36 / AJ-219：提示语由 vm 的 checkoutGate 按状态给——
      "在途（改了数量）"与"报价失败"是两件不同的事，以前被同一句"还在计算中"盖住，
      后者的结果是用户一直等一个永远算不出来的合计。
      A2（AJ-416）：固定在底部、垫在 tabBar 上方；左边是同一个权威合计（没出来时显示"—"，不显示快照价）。
    -->
    <view class="ws-buybar ws-buybar--over-tabbar" wx:if="{{rows.length > 0}}">
      <text class="ws-caption ws-buybar__note" wx:if="{{gate.hint}}">{{gate.hint}}</text>
      <view class="ws-buybar__row">
        <!-- A3：全选（与行内勾选框同一套符号） -->
        <view
          class="pick pick--all"
          hover-class="ws-press"
          bindtap="onToggleAll"
          aria-role="checkbox"
          aria-checked="{{bar.allSelected}}"
          aria-label="全选"
        >
          <text class="pick__box {{bar.allSelected ? 'pick__box--on' : ''}}">{{bar.allSelected ? '☑' : '☐'}}</text>
          <text class="ws-note pick__label">全选</text>
        </view>
        <view class="ws-buybar__sum">
          <text class="ws-note ws-buybar__label">合计</text>
          <ws-price wx:if="{{quote && quote.hasTotal}}" jpy="{{quote.totalJpy}}" size="md" />
          <text class="ws-note" wx:else>—</text>
        </view>
        <view class="ws-buybar__btn">
          <ws-button
            text="{{bar.ctaText}}"
            type="primary"
            block="{{true}}"
            disabled="{{gate.disabled}}"
            bindtap="onCheckout"
          />
        </view>
      </view>
    </view>
  </block>
</view>
