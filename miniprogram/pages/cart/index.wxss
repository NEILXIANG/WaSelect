/**
 * 购物车页样式（S3 已切到设计体系基础类）。
 *
 * ⚠️ 颜色与尺寸一律走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件，
 * 硬编码色值 / 非 0 尺寸字面量直接红）。
 */

.cart__list {
  padding-top: var(--ws-space-card);
}

/* 一行商品：图 + 信息。图固定正方形，右边信息不会随图比例忽高忽低 */
.row-item__main {
  display: flex;
}

.row-item__media {
  width: 30%;
  flex: none;
}

.row-item__body {
  flex: 1;
  min-width: 0;
  padding-left: var(--ws-space-stack);
}

.row-item__title {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* A3（AJ-416）：勾选框。触控区 ≥ --ws-touch-min；勾上用正文墨色，未勾用浅墨（不引入新颜色） */
.pick {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  min-width: var(--ws-touch-min);
  min-height: var(--ws-touch-min);
}

.pick--all {
  justify-content: flex-start;
  margin-right: var(--ws-space-inline);
}

.pick__box {
  color: var(--ws-ink-mute);
  font-size: var(--ws-f-lg);
}

.pick__box--on {
  color: var(--ws-ink);
}

.pick__label {
  margin-left: var(--ws-space-hair);
}

/* 数量步进：不用 flex gap（基础库支持不一致），靠 margin 拉间距 */
.qty {
  display: flex;
  align-items: center;
  margin-top: var(--ws-space-inline);
}

/* M-19（AJ-406）：步进与"删除"的触控区 ≥ --ws-touch-min（约 44pt）。
   @why 原先只有左右 12rpx 内边距，"−"字形本身就是全部可点面积，误触与点不中都常见。 */
.step {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: var(--ws-touch-min);
  min-height: var(--ws-touch-min);
  color: var(--ws-ink);
  font-size: var(--ws-f-lg);
}

.qty-value {
  padding: 0 var(--ws-space-inline);
  color: var(--ws-ink);
  font-size: var(--ws-f-base);
}

.remove {
  display: flex;
  align-items: center;
  min-height: var(--ws-touch-min);
  margin-left: var(--ws-space-stack);
  padding: 0 var(--ws-space-inline);
  color: var(--ws-ink-mute);
  font-size: var(--ws-f-base);
}

/* M-14：删除后的"已删除 · 撤销"行——内凹面读作"临时状态"，不与商品行混淆 */
.undo-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--ws-surface-sunk);
}

.undo-row__text {
  flex: 1;
  min-width: 0;
}

.undo-row__act {
  display: flex;
  align-items: center;
  min-height: var(--ws-touch-min);
  padding: 0 var(--ws-space-stack);
  color: var(--ws-accent-deep);
  font-size: var(--ws-f-base);
}

/* 报价明细 */
.quote-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--ws-space-hair) 0;
}

.total__rule {
  margin: var(--ws-space-inline) 0;
}

.total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

/* 空态 / 在途 / 错误 */
.state {
  text-align: center;
}

/* `.line-block` 已挪到 app.wxss（三端模拟测试 2026-10-11：结算 / 订单详情 / 支付页同病，守卫 caption-glue.unit.test.ts） */

.state__error {
  color: var(--ws-danger);
}
