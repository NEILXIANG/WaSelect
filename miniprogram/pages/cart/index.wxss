/**
 * 购物车页样式。
 *
 * ⚠️ 颜色与尺寸一律走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件，
 * 硬编码色值 / 非 0 尺寸字面量直接红）。
 */

/* 一行商品：图 + 信息（不用 flex 高度对齐——图用 widthFix，高度随图走） */
.row-item {
  display: flex;
}

.item-image {
  width: 30%;
  display: block;
  border-radius: var(--ws-radius);
}

.item-body {
  flex: 1;
  padding-left: var(--ws-space-sm);
}

.item-title {
  display: block;
  color: var(--ws-color-fg);
  font-size: var(--ws-font-sm);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-price {
  display: block;
  margin-top: var(--ws-space-sm);
  color: var(--ws-color-muted);
  font-size: var(--ws-font-sm);
}

/* 数量步进：三个可点块排一行（不用 flex gap，基础库支持不一致） */
.qty {
  display: flex;
  align-items: center;
  margin-top: var(--ws-space-sm);
}

.step {
  padding: 0 var(--ws-space-sm);
  color: var(--ws-color-fg);
  font-size: var(--ws-font-lg);
}

.qty-value {
  padding: 0 var(--ws-space-sm);
  color: var(--ws-color-fg);
  font-size: var(--ws-font);
}

.remove {
  margin-left: var(--ws-space);
  color: var(--ws-color-muted);
  font-size: var(--ws-font-sm);
}

.total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: var(--ws-space-sm);
}

.sub-price {
  display: block;
  margin-top: var(--ws-space-sm);
  color: var(--ws-color-muted);
  font-size: var(--ws-font-sm);
}

.checkout-hint {
  display: block;
  margin-top: var(--ws-space-sm);
  text-align: center;
}
