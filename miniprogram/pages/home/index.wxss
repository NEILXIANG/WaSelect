/**
 * 首页样式（I2，无 Banner 版；S3 切基础类，S4 列表换 `ws-pick-card`）。
 *
 * ⚠️ 颜色与尺寸一律走 app.wxss 的 `--ws-*` token，不在这里写死值——
 *    这不是口号：`miniprogram/design-token.unit.test.ts` 会扫描除 app.wxss 之外的所有 wxss，
 *    出现硬编码色值或非 0 尺寸字面量会直接红。
 *
 * @why 这一页保留了少量**页面自有类**（`.home__*` / `.grid*` / `.pcard*`）：
 *      基础类（`.ws-card` / `.ws-media` / `.ws-title`）管的是"这一类东西长什么样"，
 *      页面类管的是"这一页怎么摆"。把摆位也塞进基础类，那基础类就会变成第二套页面样式。
 *
 * @limitation 商品图用正方形容器（`ws-media--square`，padding-bottom 撑高）而不是 `widthFix`：
 *      `widthFix` 下每张卡的高度随图片比例变，两列布局会出现参差；
 *      正方形容器让列表始终整齐，代价是图会被裁切（`aspectFill`）。
 *      ⚠️ 真数据当前**没有图**，所以现在看到的是 `.ws-media` 的底色块——这是预期，不是坏了。
 */

/* ── 报头：字标 ────────────────────────────────────────────────── */
.home__bar {
  padding-top: var(--ws-space-card);
  padding-bottom: var(--ws-space-stack);
}

.home__mark-cn {
  display: block;
  font-family: var(--ws-font-serif);
  font-size: var(--ws-f-xl);
  line-height: var(--ws-lh-tight);
  color: var(--ws-ink);
}

.home__mark-en {
  display: block;
  margin-top: var(--ws-space-hair);
  font-size: var(--ws-f-caption);
  letter-spacing: var(--ws-ls-wide);
  text-transform: uppercase;
  color: var(--ws-ink-mute);
}

/* ── 搜索行 ────────────────────────────────────────────────────── */
/* 搜索栏（用户 2026-10-11 截图指出比例失调）：一整条胶囊，输入框占满，右端小号「搜索」嵌在框里 */
.home__searchbox {
  display: flex;
  align-items: center;
  padding: var(--ws-space-hair) var(--ws-space-hair) var(--ws-space-hair) var(--ws-space-stack);
  background: var(--ws-surface-sunk);
  border-radius: var(--ws-radius-pill);
}

/* 放大镜：一个圆环 + 斜柄，用边框画（不引图片资源） */
.home__glass {
  position: relative;
  flex: none;
  box-sizing: border-box;
  width: var(--ws-space-stack);
  height: var(--ws-space-stack);
  margin-right: var(--ws-space-inline);
  border: calc(var(--ws-border-width) * 2) solid var(--ws-ink-mute);
  border-radius: 50%;
}

.home__glass::after {
  content: '';
  position: absolute;
  right: calc(var(--ws-space-tight) * -1.5);
  bottom: calc(var(--ws-space-tight) * -1);
  width: var(--ws-space-hair);
  height: calc(var(--ws-border-width) * 2);
  background: var(--ws-ink-mute);
  transform: rotate(45deg);
}

.home__search {
  flex: 1;
  min-width: 0;
  font-size: var(--ws-f-base);
  color: var(--ws-ink);
}

.home__go {
  flex: none;
  margin-left: var(--ws-space-hair);
  padding: var(--ws-space-hair) var(--ws-space-stack);
  font-size: var(--ws-f-sm);
  color: var(--ws-ink-inverse);
  background: var(--ws-accent);
  border-radius: var(--ws-radius-pill);
}

/* ── 轮播（D-51）──────────────────────────────────────────────────
   @why 高度走 `--ws-banner-h` 而不是百分比撑高：swiper 是**固定高度**组件，
        它的高度不由内容撑开（`padding-bottom` 那套对 swiper 无效），
        只能显式给——所以这个尺寸必须是个有名字的 token。
   @why 圆角只给 `--ws-radius-sm`（10rpx）：图片自身一律小圆角/直角（设计规范），
        大圆角配暖色会滑向"亲和力过度"，那不是本品牌的调性。
   @why `overflow: hidden` 配合圆角：不给的话 `aspectFill` 的图会从圆角处溢出，
        在真机上看成"圆角没生效"。 */
.home__swiper {
  height: var(--ws-banner-h);
  margin-top: var(--ws-space-card);
  border-radius: var(--ws-radius-sm);
  overflow: hidden;
}

/* swiper-item 内的点击层（P2-41：hover-class 只在 view 上生效）——撑满整张图。 */
.home__slide-hit {
  width: 100%;
  height: 100%;
}

.home__slide {
  display: block;
  width: 100%;
  height: 100%;
  background: var(--ws-surface-sunk);
}

/* ── 分类 tab ──────────────────────────────────────────────────── */
.home__cats {
  display: flex;
  align-items: stretch;
  margin-top: var(--ws-space-card);
  border-bottom: var(--ws-border-width) solid var(--ws-line);
}

.tabs {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

/* 文字页签（与订单页 .order-tabs__item 同一套：灰字 → 选中墨色 + 强调色下划线） */
.tab {
  display: inline-block;
  min-height: var(--ws-touch-min);
  line-height: var(--ws-touch-min);
  margin-right: var(--ws-space-card);
  color: var(--ws-ink-mute);
  font-size: var(--ws-f-base);
  border-bottom: var(--ws-hair-thick) solid transparent;
}

.tab--active {
  color: var(--ws-ink);
  font-weight: 600;
  border-bottom-color: var(--ws-accent);
}

/* 右侧「分类 ▾」：底色同页面，左侧渐隐盖住滚出去的页签，提示"还能往右滑" */
.home__cats-all {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  padding-left: var(--ws-space-inline);
  color: var(--ws-ink-soft);
  font-size: var(--ws-f-sm);
  background: var(--ws-canvas);
}

.home__cats-all::before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  right: 100%;
  width: var(--ws-space-section);
  background: linear-gradient(to right, transparent, var(--ws-canvas));
}

.home__cats-caret {
  width: 0;
  height: 0;
  margin-left: var(--ws-space-tight);
  border-left: var(--ws-space-tight) solid transparent;
  border-right: var(--ws-space-tight) solid transparent;
  border-top: var(--ws-space-hair) solid var(--ws-ink-soft);
}

.home__cats-caret--up {
  transform: rotate(180deg);
}

/* 全部分类面板：四列网格，选中项强调色 */
.home__cat-panel {
  display: flex;
  flex-wrap: wrap;
  padding-top: var(--ws-space-inline);
  padding-bottom: var(--ws-space-inline);
  border-bottom: var(--ws-border-width) solid var(--ws-line);
}

.home__cat-cell {
  width: 25%;
  min-height: var(--ws-touch-min);
  line-height: var(--ws-touch-min);
  text-align: center;
  color: var(--ws-ink-soft);
  font-size: var(--ws-f-sm);
}

.home__cat-cell--active {
  color: var(--ws-accent-deep);
  font-weight: 600;
}

/* ── 商品流（S4 起：纵向编辑大卡，不再是两列网格）─────────────────────
   @why 两列网格是**卖场**形态："先看图、再看价"；而本品牌的判断是
        "先看值不值、再看多少钱"，`why` 那一整段需要横向的篇幅才读得下去。
        原型的设计规范里首页/发现/分类**都是**纵向大卡，两列是例外。
   @why 卡与卡之间用"非第一张才给上间距"：列表是 `wx:for` 生成的，
        给每张卡 `margin-top` 会让第一张上面也空一档（那里已经有一档 tab 间距了）。 */
.home__list {
  margin-top: var(--ws-space-card);
}

.home__pick + .home__pick {
  margin-top: var(--ws-space-section);
}

/* ── 页脚 ──────────────────────────────────────────────────────── */
.footer {
  padding: var(--ws-space-card);
  text-align: center;
}

/* A4 / A11（2026-10-09）：搜索状态行与页脚重试。只用既有 token，不引入新颜色 / 新字号 */
.home__searching {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--ws-space-hair);
}

.home__clear,
.home__more-retry {
  color: var(--ws-ink);
  text-decoration: underline;
  padding: var(--ws-space-hair) 0;
}
