/**
 * 首页样式（I2，无 Banner 版）。
 *
 * ⚠️ 颜色与尺寸一律走 app.wxss 的 `--ws-*` token，不在这里写死值——
 *    这不是口号：`miniprogram/design-token.unit.test.ts` 会扫描除 app.wxss 之外的所有 wxss，
 *    出现硬编码色值或非 0 尺寸字面量会直接红。
 *
 * @limitation 商品图用 `widthFix`（宽度撑满、高度随图）而不是固定高 + `aspectFill`：
 *            固定高需要一个"卡片图高"的 token，为一个还没定版的列表先加档位是过度设计。
 *            代价是图比例不一时列表会参差——占位图是正方形，真实商品图统一为一比一
 *            即可消除（这是运营口径，不是代码问题）。
 */

/* 搜索栏：输入框占满剩余宽度，按钮按内容宽 */
.toolbar {
  display: flex;
  align-items: center;
  margin: var(--ws-space) var(--ws-space) 0;
}

.search {
  flex: 1;
  padding: var(--ws-space-sm) 0;
  font-size: var(--ws-font);
  border-bottom: var(--ws-border-width) solid var(--ws-color-muted);
}

.search-btn {
  margin-left: var(--ws-space-sm);
}

/* 分类 tab：横向可滚（分类数超过一屏时不出界、不断行） */
.tabs {
  white-space: nowrap;
  margin: var(--ws-space) 0 0;
}

.tab {
  display: inline-block;
  padding: var(--ws-space-sm) var(--ws-space);
  color: var(--ws-color-muted);
  font-size: var(--ws-font);
}

.tab--active {
  color: var(--ws-color-fg);
  font-weight: bold;
}

/* 商品流：两列。⚠️ 用 padding + border-box 做间隙，不用 flex gap——
   基础库对 flex gap 的支持不一致，而它失效的表现只是"没有间隙"，反而更安全。 */
.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 50%;
  box-sizing: border-box;
  padding: var(--ws-space-sm);
}

.product-card {
  background: var(--ws-color-card);
  border-radius: var(--ws-radius);
  overflow: hidden;
}

.product-image {
  width: 100%;
  display: block;
}

.product-body {
  padding: var(--ws-space-sm);
}

.product-title {
  display: block;
  color: var(--ws-color-fg);
  font-size: var(--ws-font-sm);
  /* 两行截断：超长标题把价格挤出首屏，比"显示不全"贵得多 */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.sub-price {
  display: block;
  margin-top: var(--ws-space-sm);
  color: var(--ws-color-muted);
  font-size: var(--ws-font-sm);
}

.sold-out {
  display: block;
  margin-top: var(--ws-space-sm);
  color: var(--ws-color-error);
  font-size: var(--ws-font-sm);
}

.footer {
  padding: var(--ws-space);
  text-align: center;
}
