<!--
  订单详情（I2）："这单到底走到哪了"——时间线 / 运单号 / 地址快照 / 条款版本。

  S3（2026-10-02）：版式换成设计体系（`.ws-*` 基础类），信息架构与行为不动。

  ⚠️ 时间全部按 JST 显示（UTC 存、JST 显，转换在 utils/jst-text.js 纯函数里，有单测），
    且**每个时刻都带"（日本时间）"**——美国买家会把不带时区的截止时刻读成本地时间（MP3-02）。

  ⚠️ 关税是**信息字段**（含在商品价内），vm 给它的标签写死了"含在商品价内"——
  别在 wxml 里把它改成"关税：另收"那一类说法。

  ⚠️ 取消按钮只在可取消态出现（vm 的 canCancel，与可付态同源）；
  点了先弹模态确认（showModal），成功后原地重取。

  样式只走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件对应的 wxss）。
-->
<view class="ws-page {{view.hasActions ? 'ws-page--with-buybar' : ''}} order-detail">
  <!-- P2-38：错误态给"重试"；链接里没有订单 id 时重试也没用，不给按钮（retryable） -->
  <ws-state-block
    wx:if="{{error}}"
    kind="fail"
    title="订单信息没能取到或操作没有完成"
    reason="{{error}}"
    refText="{{errorRef}}"
    actionText="{{errorContact ? '联系客服' : retryable ? '重试' : ''}}"
    bindaction="onRetry"
  />

  <view class="ws-gutter" wx:if="{{loading && !view}}">
    <view class="ws-card state">
      <text class="ws-note">正在加载订单…</text>
    </view>
  </view>

  <block wx:if="{{view}}">
    <view class="ws-gutter ws-section">
      <view class="ws-card">
        <!-- M-06（AJ-405）：状态用买家视角文案（vm 给），下面一句"下一步会发生什么" -->
        <view class="head">
          <text class="ws-title head__status-text">{{view.statusText}}</text>
        </view>
        <text class="ws-note hint" wx:if="{{view.nextText}}">{{view.nextText}}</text>
        <!-- M-12（AJ-408）：进度条（vm utils/order-progress.js）。终态（取消 / 超时 / 退款）= 点亮到发生前那一步 + 分支标签；
             不带时刻（时区标注放不下，完整时刻见下方时间线） -->
        <view class="progress" wx:if="{{view.progress.show}}" aria-label="订单进度">
          <view class="progress__step progress__step--{{item.state}}" wx:for="{{view.progress.steps}}" wx:key="key">
            <view class="progress__dot"></view>
            <text class="progress__label">{{item.label}}</text>
          </view>
        </view>
        <text class="ws-tag progress__branch" wx:if="{{view.progress.branch}}">{{view.progress.branch.title}}</text>
        <!-- M-05（AJ-405）：订单号可复制（客服第一句就要单号）；反馈页内"已复制"，不弹 toast -->
        <view class="quote-line order-no" wx:if="{{view.orderNo}}">
          <text class="ws-caption key-info head__no" user-select>订单号 {{view.orderNo}}</text>
          <!-- M-19（AJ-406）：可点的"复制"改成 view（hover-class 只对 view 生效）并加大触控区 -->
          <view class="track track--act" hover-class="ws-press" bindtap="onCopyOrderNo" aria-role="button" aria-label="复制订单号">{{copied === 'order' ? '已复制' : '复制'}}</view>
        </view>
        <!-- MP3-04：刚付过款、服务端还没确认——这时不给继续支付也不给取消，只说清在确认中 -->
        <text class="ws-note hint" wx:if="{{view.confirmHint}}">{{view.confirmHint}}</text>
        <text class="ws-caption key-info hint" wx:if="{{view.createdAtText}}">建单 {{view.createdAtText}}</text>
        <!--
          MP3-02：`expiresAtText` 自带"（日本时间）"。收货人是美国地址的用户，
          不标时区时这一行会被读成本地时间（PDT 与 JST 差 16 小时）→ 以为还有一整天。
        -->
        <text class="ws-caption key-info hint" wx:if="{{view.expiresAtText}}">请在 {{view.expiresAtText}} 前完成支付</text>
      </view>
    </view>

    <!--
      M-05（AJ-405）：客服卡上移到状态区下方（原在页面最底部）。剩余清单 4-2：服务端未配置时不显示；长按可选中复制。
    -->
    <view class="ws-gutter ws-section" wx:if="{{support.length > 0}}">
      <view class="ws-card">
        <text class="ws-note">对订单有疑问？联系客服</text>
        <text class="ws-caption key-info hint">联系客服时请提供订单号</text>
        <view class="quote-line" wx:for="{{support}}" wx:key="key">
          <text class="ws-note">{{item.label}}</text>
          <text class="ws-body" user-select>{{item.value}}</text>
        </view>
      </view>
    </view>

    <!--
      售后（AJ-420）：入口 + 最新一条申请的进度。放在客服卡之后：两者都是"订单有问题时找谁"。
    -->
    <view class="ws-gutter ws-section" wx:if="{{view.afterSale.show}}">
      <view class="ws-card">
        <text class="ws-note">售后</text>
        <block wx:if="{{view.afterSale.current}}">
          <view class="quote-line">
            <text class="ws-body">{{view.afterSale.current.reasonText}}</text>
            <text class="ws-tag">{{view.afterSale.current.statusText}}</text>
          </view>
          <text class="ws-caption hint" user-select>{{view.afterSale.current.description}}</text>
          <text class="ws-body hint" wx:if="{{view.afterSale.current.note}}" user-select>处理说明：{{view.afterSale.current.note}}</text>
          <text class="ws-caption hint">提交于 {{view.afterSale.current.atText}}</text>
        </block>
        <view
          class="track track--act"
          wx:if="{{view.afterSale.canApply}}"
          hover-class="ws-press"
          bindtap="onApplyAfterSale"
          aria-role="button"
          aria-label="申请售后"
        >{{view.afterSale.current ? '还有问题？再次申请售后' : '收到的商品有问题？申请售后'}}</view>
      </view>
    </view>

    <view class="ws-gutter ws-section" wx:if="{{view.items.length > 0}}">
      <view class="ws-card">
        <text class="ws-section-kicker">Items</text>
        <!-- A7（AJ-416）：商品行可点进详情（看看现在还卖不卖、什么价） -->
        <view
          class="item"
          wx:for="{{view.items}}"
          wx:key="productId"
          data-id="{{item.productId}}"
          bindtap="onOpenItem"
          hover-class="ws-press"
          aria-role="link"
          aria-label="查看 {{item.title}} 详情"
        >
          <view class="item__media">
            <view class="ws-media ws-media--square">
              <image wx:if="{{item.image}}" class="ws-media__img" src="{{item.image}}" mode="aspectFill" lazy-load />
            </view>
          </view>
          <view class="item__body">
            <text class="ws-title item__title">{{item.title}}</text>
            <view class="item__meta">
              <text class="ws-note" wx:if="{{item.unitPriceText}}">{{item.unitPriceText}}</text>
              <text class="ws-note item__qty">× {{item.qty}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="ws-gutter ws-section">
      <view class="ws-card">
        <text class="ws-section-kicker">Amount</text>
        <view class="quote-line" wx:for="{{view.amountLines}}" wx:for-item="line" wx:key="label">
          <text class="ws-note">{{line.label}}</text>
          <text class="ws-body">{{line.value}}</text>
        </view>
        <view class="ws-hair total__rule" />
        <view class="total">
          <text class="ws-note">{{view.totalLabel}}</text>
          <ws-price wx:if="{{view.totalJpy !== null}}" jpy="{{view.totalJpy}}" size="lg" />
        </view>
        <text class="ws-caption" wx:if="{{view.totalSub}}">{{view.totalSub}}</text>
        <!--
          P2-12（AJ-386）部分退款（成功 / 处理中）。AJ-434：放进金额卡、紧跟订单合计——
          原先是页面最底部单独一张卡，买家核对"付了多少、退了多少"要上下翻。
          金额前不加负号：认不出的币种显示"EUR（金额以银行账单为准）"，带负号读不通。
        -->
        <block wx:if="{{view.partialRefunds.length > 0}}">
          <view class="ws-hair total__rule" />
          <view wx:for="{{view.partialRefunds}}" wx:for-item="r" wx:key="key">
            <view class="quote-line">
              <text class="ws-note">部分退款 · {{r.statusText}}</text>
              <text class="ws-body">{{r.amountText}}</text>
            </view>
            <text class="ws-caption">{{r.atText}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="ws-gutter ws-section" wx:if="{{view.address}}">
      <view class="ws-card">
        <text class="ws-section-kicker">Shipping to</text>
        <text class="ws-body line">{{view.address.recipient}} · {{view.address.phone}}</text>
        <text class="ws-body line">{{view.address.line1}}</text>
        <text class="ws-body line" wx:if="{{view.address.line2}}">{{view.address.line2}}</text>
        <text class="ws-body line">{{view.address.region}}</text>
        <!-- 联动走查·熟手买家：已付款未发货时说明改地址的出路（买家端没有自助改址） -->
        <text class="ws-caption key-info line" wx:if="{{view.addressChangeHint}}">{{view.addressChangeHint}}</text>
      </view>
    </view>

    <view class="ws-gutter ws-section" wx:if="{{view.hasTracking}}">
      <view class="ws-card">
        <text class="ws-section-kicker">Tracking</text>
        <view class="quote-line" wx:if="{{view.carrier}}">
          <text class="ws-note">承运商</text>
          <text class="ws-body">{{view.carrier}}</text>
        </view>
        <view class="quote-line">
          <text class="ws-note">运单号</text>
          <!-- ⚠️ 用 text 不是 view：`hover-class` 只支持 view/button/navigator，
               而这里要的是"可长按选择的等宽文本"，按下反馈对它不适用。 -->
          <text class="ws-body track" data-no="{{view.trackingNo}}" data-kind="no" bindtap="onCopyTracking">
            {{copied === 'no' ? '已复制' : view.trackingNo}}
          </text>
        </view>
        <!-- 第 24 项：查件引导由 vm 给（有官方链接 / 没有，两种说法） -->
        <text class="ws-caption hint">{{view.trackingHint}}</text>
        <!-- 剩余清单 3-5：官方查件链接（复制后到浏览器打开；小程序内不能直接打开外部网页） -->
        <view class="quote-line" wx:if="{{view.trackingUrl}}">
          <text class="ws-note">查件</text>
          <text class="ws-body track" data-no="{{view.trackingUrl}}" data-kind="url" bindtap="onCopyTracking">
            {{copied === 'url' ? '已复制' : '复制查件链接'}}
          </text>
        </view>
        <!-- 第 24 项：复制成功后给出下一步——小程序里打不开外部网页，只能去浏览器 -->
        <text class="ws-caption key-info hint" wx:if="{{copied === 'url'}}">已复制：打开手机浏览器，粘贴到地址栏即可查看物流</text>
      </view>
    </view>

    <view class="ws-gutter ws-section" wx:if="{{view.timeline.length > 0}}">
      <view class="ws-card">
        <text class="ws-section-kicker">Progress</text>
        <text class="ws-note timeline__title">订单进展</text>
        <view class="quote-line" wx:for="{{view.timeline}}" wx:for-item="t" wx:key="key">
          <text class="ws-body">{{t.statusText}}</text>
          <text class="ws-caption">{{t.atText}}</text>
        </view>
        <!--
          AJ-295：把"会收到什么通知"**如实说出来**——不说的话用户会一直等一个不会来的消息。
          复核 2026-10-06：AJ-369 已上线订单邮件（order.paid / shipped / refunded → contact_email），
          原句"不会有推送通知"已不成立；订阅消息仍未做（B3），签收也不发信。
          ⚠️ 前提是生产配了 MAIL_PROVIDER_API_KEY（上线运维手册 §1.1）；没配就是又一句不成立的承诺。
        -->
        <text class="ws-caption hint">留了联系邮箱的，付款、发货、退款时会收到邮件；签收不另行通知，进度请回到这一页查看。</text>
      </view>
    </view>

    <view class="ws-gutter ws-section" wx:if="{{view.termsVersion || view.contactEmail}}">
      <view class="ws-card">
        <view class="quote-line" wx:if="{{view.termsVersion}}">
          <text class="ws-note">条款版本</text>
          <text class="ws-body">{{view.termsVersion}}</text>
        </view>
        <view class="quote-line" wx:if="{{view.contactEmail}}">
          <text class="ws-note">联系邮箱</text>
          <text class="ws-body">{{view.contactEmail}}</text>
        </view>
      </view>
    </view>

    <!--
      A2（AJ-416）：操作固定在底部（有可做的动作才出栏，vm hasActions）。
      次要动作（取消订单，描边）在左、主要动作（继续支付 / 确认收货，实心）在右——右手拇指先够到的是主动作。
    -->
    <view class="ws-buybar" wx:if="{{view.hasActions}}">
      <text class="ws-note state__error ws-buybar__note" wx:if="{{buyAgainNote}}">{{buyAgainNote}}</text>
      <view class="ws-buybar__row">
        <view class="ws-buybar__sum">
          <text class="ws-note ws-buybar__label" wx:if="{{view.canPay && view.totalJpy !== null}}">应付</text>
          <ws-price wx:if="{{view.canPay && view.totalJpy !== null}}" jpy="{{view.totalJpy}}" size="md" />
        </view>
        <view class="ws-buybar__btn" wx:if="{{view.canCancel}}">
          <ws-button
            text="{{cancelling ? '取消中…' : '取消订单'}}"
            type="default"
            block="{{true}}"
            loading="{{cancelling}}"
            bindtap="onCancelTap"
          />
        </view>
        <view class="ws-buybar__btn" wx:if="{{view.canPay}}">
          <ws-button text="继续支付" type="primary" block="{{true}}" bindtap="onPay" />
        </view>
        <!-- A7（AJ-416）：结束了的单（送达 / 完成 / 取消 / 超时 / 已退款）→ 同样的商品放回购物车 -->
        <view class="ws-buybar__btn" wx:if="{{view.canBuyAgain}}">
          <ws-button text="再次购买" type="primary" block="{{true}}" bindtap="onBuyAgain" />
        </view>
        <!-- P2-13（AJ-387）：确认收货；不点也会在发货 30 天后自动签收 -->
        <view class="ws-buybar__btn" wx:if="{{view.canConfirmReceipt}}">
          <ws-button
            text="{{confirmingReceipt ? '提交中…' : '确认收货'}}"
            type="primary"
            block="{{true}}"
            loading="{{confirmingReceipt}}"
            bindtap="onConfirmReceiptTap"
          />
        </view>
      </view>
    </view>
  </block>

  <!-- P2-11（AJ-386）：关单后才到的付款 -->
  <view class="ws-gutter ws-section" wx:if="{{view.latePaidNote}}">
    <text class="ws-note">{{view.latePaidNote}}</text>
  </view>

  <!-- 剩余清单 4-10：缺货整单退款说明（仅已付款未发货） -->
  <view class="ws-gutter ws-section" wx:if="{{view.stockRefundNote}}">
    <text class="ws-note">{{view.stockRefundNote}}</text>
  </view>
</view>
