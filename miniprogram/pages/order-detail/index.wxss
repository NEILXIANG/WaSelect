/**
 * 订单详情页样式（S3 已切到设计体系基础类）。
 *
 * ⚠️ 颜色与尺寸一律走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件，
 * 硬编码色值 / 非 0 尺寸字面量直接红）。
 * ⚠️ 与订单列表 / 结算页同名的类（`.quote-line` / `.total` / `.hint` / `.line`）
 * 刻意重名不复制样式意图——同一块视觉，改一处即多处（design token 的本意）。
 */

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.head__no {
  flex: 1;
  min-width: 0;
}

.head__status {
  flex: none;
  margin-left: var(--ws-space-inline);
}

/* M-06：状态区标题（买家视角文案较长，单独一行） */
.head__status-text {
  flex: 1;
  min-width: 0;
}

/* M-05：订单号 + 复制 */
.order-no {
  margin-top: var(--ws-space-inline);
}

.hint {
  display: block;
  margin-top: var(--ws-space-hair);
}

/* 行项目：左图右文。图宽用百分比（token 里没有"缩略图"这一档） */
.item {
  display: flex;
  margin-top: var(--ws-space-inline);
}

.item__media {
  width: 20%;
  flex: none;
}

.item__body {
  flex: 1;
  min-width: 0;
  margin-left: var(--ws-space-inline);
}

.item__title {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item__meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: var(--ws-space-hair);
}

.item__qty {
  flex: none;
  margin-left: var(--ws-space-inline);
}

/* 金额明细（与结算页同名同义） */
.quote-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--ws-space-hair) 0;
}

.total__rule {
  margin: var(--ws-space-inline) 0;
}

.total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.timeline__title {
  display: block;
  margin-bottom: var(--ws-space-hair);
}

.line {
  display: block;
  margin-top: var(--ws-space-hair);
}

/* 运单号：整块可点复制（用 text 不是 button——页面不允许原生可点 button） */
.track {
  text-align: right;
  word-break: break-all;
  color: var(--ws-accent);
}

/* 底部动作区 */
.cta {
  padding-bottom: var(--ws-space-section);
}

.cancel-btn {
  margin-top: var(--ws-space-inline);
}

/* 加载 / 错误 */
.state {
  text-align: center;
}

.state__error {
  color: var(--ws-danger);
}
