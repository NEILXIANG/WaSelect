<!--
  法务页（I2）：当前生效的条款版本 + 三语种链接（复制后在浏览器打开）。

  S3（2026-10-02）：版式换成设计体系（`.ws-*` 基础类），**信息架构与行为都不动**——
  版本号 / 三语种链接 / 复制动作 / 空态一个没少。

  ⚠️ 条款正文**不在小程序里**：正文的单一事实源是 GET /terms 的 urls 指向的静态页。
  这里再抄一份的后果是"改了条款、小程序还是旧版"，而版本号对得上——比没有更危险。

  ⚠️ 空态只在"确实没有可查看的语种"时显示——请求失败时说"暂时没有"，
  用户会读成"这家店没有条款"。@see index.vm.js 的 legalState
-->
<view class="ws-page">
  <ws-section-head
    class="ws-gutter legal__head"
    kicker="Terms &amp; Policies"
    title="条款与政策"
  />

  <ws-state-block
    wx:if="{{error}}"
    kind="fail"
    title="没能取到条款"
    reason="{{error}}"
    actionText="重试"
    bindaction="onRetry"
  />

  <ws-state-block wx:if="{{state.showLoading}}" kind="loading" title="正在加载条款" compact="{{true}}" />

  <!-- 空态：**只显示空态本身**——请求失败时说"暂时没有"，
       用户会读成"这家店没有条款"（@see index.vm.js 的 legalState）。 -->
  <ws-state-block
    wx:if="{{state.showEmpty}}"
    kind="empty"
    title="暂时没有可查看的条款"
    reason="条款版本通常在店铺上线前配置好；稍后再来，或联系客服索取"
    compact="{{true}}"
  />

  <!-- 版本号：这一页的凭据，单独一张卡 -->
  <view class="ws-gutter" wx:if="{{version}}">
    <view class="ws-card legal__card">
      <view class="legal__row">
        <text class="ws-note">当前生效版本</text>
        <text class="legal__version">{{version}}</text>
      </view>
    </view>
  </view>

  <view class="ws-gutter" wx:if="{{state.showList}}">
    <view class="ws-card legal__card">
      <text class="ws-note">复制链接后在浏览器中打开查看全文</text>

      <!-- 语种块之间用发丝线分隔：三块共用一个 card，不加线时
           "复制链接"这个动作会和上一个语种的 url 读成一条 -->
      <view class="doc" wx:for="{{langs}}" wx:key="key">
        <view class="doc-head">
          <text class="doc-label">{{item.label}}</text>
          <!-- ⚠️ 用 view 而不是 text：`hover-class` 只支持 view/button/navigator，
               写在 <text> 上不生效——点了没有变淡反馈，用户会以为没点到。 -->
          <view
            class="doc-act"
            data-url="{{item.url}}"
            data-key="{{item.key}}"
            hover-class="ws-press"
            bindtap="onCopy"
          >{{copied === item.key ? '已复制' : '复制链接'}}</view>
        </view>
        <!-- ⚠️ url 保持 <text> 且带 user-select：复制失败时它是唯一的兜底手段，
             所以必须能长按选中——view 里的文字长按选不中（这也是它与上面那个
             动作区分开的原因：一个要"选中"，一个要"点"）。 -->
        <text class="doc-url" user-select>{{item.url}}</text>
      </view>
    </view>
    <text class="ws-note" wx:if="{{copyError}}">{{copyError}}</text>
  </view>
</view>
