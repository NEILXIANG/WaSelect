/**
 * 法务页样式。
 *
 * ⚠️ 颜色与尺寸一律走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件，
 * 硬编码色值 / 非 0 尺寸字面量直接红）。
 */

/* 版本号：与左侧"当前生效版本"标签同基线对齐，用主色强调它是这一页的凭据 */
.version {
  color: var(--ws-color-fg);
  font-size: var(--ws-font-sm);
  word-break: break-all;
}

/* 语种块之间留一档小间距；三块共用一个 card，不加分隔线（token 里没有线色） */
.doc {
  margin-top: var(--ws-space);
}

.doc-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.doc-label {
  color: var(--ws-color-fg);
  font-size: var(--ws-font-sm);
}

/* "复制链接 / 已复制"：整行可点的文字动作（用 text 不是 button——页面不允许原生可点 button） */
.doc-act {
  color: var(--ws-color-fg);
  font-size: var(--ws-font-sm);
}

/* url 整行显示且可长按选中（user-select）：复制失败时它是唯一的兜底手段 */
.doc-url {
  display: block;
  margin-top: var(--ws-space-sm);
  color: var(--ws-color-muted);
  font-size: var(--ws-font-sm);
  word-break: break-all;
}
