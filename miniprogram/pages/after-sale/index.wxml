<!--
  售后申请（AJ-420）：选问题类型 + 描述 → 提交 → 回订单详情看进度。
  版式沿用地址编辑页的设计体系（ws-section-head / ws-card / ws-field / ws-button），不引入新样式语言。
  ⚠️ 错误在页面内显示，不弹 toast（与地址编辑页同口径）。
  ⚠️ 提交按钮只在提交中禁用：缺项时也要能点，点了由页面内提示说缺什么（统一结论 5.3；禁用的灰按钮不告诉人缺什么）。
-->
<view class="ws-page">
  <!-- 外边距放在包一层的 view 上：类名写在自定义组件标签上时页面的 ws-gutter 不生效（模拟器截图实测：标题贴左边） -->
  <view class="ws-gutter as__head"><ws-section-head kicker="After-sales" title="申请售后" /></view>

  <ws-state-block
    wx:if="{{error}}"
    kind="fail"
    title="打不开售后申请"
    reason="{{error}}"
    altText="返回"
    bindalt="onBack"
  />

  <block wx:if="{{!error}}">
    <!-- 全入口点击测试 2026-10-11：顶部显示是哪一单（原先没有，买家会怀疑点错了单） -->
    <view class="ws-gutter as__brief-wrap" wx:if="{{brief}}">
      <view class="ws-card as__brief">
        <view class="as__thumb">
          <view class="ws-media ws-media--square">
            <image wx:if="{{brief.image}}" class="ws-media__img" src="{{brief.image}}" mode="aspectFill" webp="{{true}}" />
          </view>
        </view>
        <view class="as__brief-body">
          <text class="ws-body as__brief-title">{{brief.title}}<text class="ws-note" wx:if="{{brief.moreText}}"> {{brief.moreText}}</text></text>
          <text class="ws-caption line-block" wx:if="{{brief.orderNo}}">订单号 {{brief.orderNo}}</text>
        </view>
      </view>
    </view>
    <view class="ws-gutter">
      <view class="ws-card as__form">
        <ws-field label="问题类型">
          <picker mode="selector" range="{{reasonLabels}}" value="{{form.reasonIndex < 0 ? 0 : form.reasonIndex}}" bindchange="onReasonPick">
            <!-- 全入口点击测试 2026-10-11：加「▾」表明是下拉（原先与文字框长得一样） -->
            <view class="input input--picker {{view.reasonText ? '' : 'ph'}}">
              <text>{{view.reasonText || '请选择'}}</text>
              <text class="picker-caret">▾</text>
            </view>
          </picker>
        </ws-field>

        <ws-field label="问题描述">
          <textarea
            class="input as__desc"
            value="{{form.description}}"
            maxlength="{{max}}"
            bindinput="onInput"
            placeholder="请写清是哪件商品、什么问题，例：外箱压扁，罐子凹了一块"
            placeholder-class="ph"
          />
          <text class="ws-caption as__count {{view.overLimit ? 'as__count--over' : ''}}">{{view.countText}}</text>
        </ws-field>
      </view>
    </view>

    <view class="ws-gutter as__foot">
      <text class="field__error" wx:if="{{saveError}}">{{saveError}}</text>
      <text class="ws-caption" wx:if="{{saveErrorRef}}" user-select>{{saveErrorRef}}</text>
      <ws-button
        text="{{submitting ? '提交中…' : '提交申请'}}"
        type="primary"
        disabled="{{submitting}}"
        loading="{{submitting}}"
        bindtap="onSubmit"
      />
      <text class="ws-note tip">提交后我们会在订单详情里回复处理结果；需要补充照片请联系客服并提供订单号。</text>
    </view>
  </block>
</view>
