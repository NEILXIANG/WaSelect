<!--
  「我的」（I2）：登录态 + 三个入口——订单 / 地址 / 条款。

  S3（2026-10-02）：版式换成设计体系（`.ws-*` 基础类），**信息架构与行为都不动**。

  ⚠️ 这三个页此前没有任何入口：注册了、能跑，但从首页出发走不到。
  本页是它们唯一的入口，所以入口清单在 vm 里集中维护，
  "加一个入口忘了接跳转"由单测断言（index.vm.unit.test.ts 最后一组）。

  剩余清单 4-2：客服卡由 GET /support 驱动——客服账号未配置时服务端回空对象，整张卡不显示
  （写一个假的微信号比没有更贵，用户会真的去加）。

  @why S5 之后本页是 4 个 tab 页之一（底部有自定义 tabBar），所以根容器用
       `.ws-page--with-tabbar` 给底部留位——现在 tabBar 还没上，留位不影响布局，
       等 S5 上 tabBar 时不会因为最后一行被挡住而再改一次这一页。
-->
<view class="ws-page ws-page--with-tabbar">
  <!-- 页头（S4：走 `ws-section-head` 组件，与其余页头同一份实现） -->
  <!-- 外边距放在包一层的 view 上：类名写在自定义组件标签上时页面的 ws-gutter 不生效（模拟器截图实测：标题贴左边） -->
  <view class="ws-gutter mine__head"><ws-section-head kicker="Mine" title="我的" /></view>

  <!-- 登录态：一行，左标签右值。
       小程序评估（AJ-416）：只在"正在登录 / 没登上 / 要重试"时出现——登录成功后"已登录"一行没有信息量，
       还把订单入口往下挤了一截。 -->
  <view class="ws-gutter" wx:if="{{!login.logged || retry.show}}">
    <view class="ws-card mine__card">
      <view class="mine__row">
        <text class="ws-note">登录状态</text>
        <text class="mine__value">{{login.text}}</text>
      </view>
      <!-- M-17（AJ-406）：启动登录失败时给出路（此前只有一句"下次操作时会自动重试"，没有按钮） -->
      <view class="mine__retry" wx:if="{{retry.show}}">
        <ws-button text="{{retry.text}}" type="default" disabled="{{retry.disabled}}" bindtap="onRetryLogin" />
        <text class="ws-note mine__retry-note" wx:if="{{retry.note}}">{{retry.note}}</text>
      </view>
    </view>
  </view>

  <!-- M-10 附（AJ-408）：四个订单入口（待付款 / 采购中 / 已发货 / 售后·退款），点了进订单页对应页签；
       角标只数进行中的单（vm orderShortcuts），取数失败时不显示角标 -->
  <view class="ws-gutter mine__menu-wrap">
    <view class="ws-card mine__orders">
      <!-- 全入口点击测试 2026-10-11：标题行「我的订单 · 全部订单 ›」（原先下方菜单另有一行「我的订单」，两处说同一件事） -->
      <view
        class="mine__orders-head"
        data-key="{{ordersEntry.key}}"
        hover-class="ws-press"
        bindtap="onMenuTap"
        aria-role="link"
        aria-label="{{ordersEntry.label}}，{{ordersEntry.actionText}}"
      >
        <text class="mine__orders-title">{{ordersEntry.label}}</text>
        <text class="ws-note mine__orders-all">{{ordersEntry.actionText}} ›</text>
      </view>
      <view class="mine__order-row">
      <view
        class="mine__order-entry"
        wx:for="{{shortcuts}}"
        wx:key="key"
        data-key="{{item.key}}"
        hover-class="ws-press"
        bindtap="onShortcutTap"
        aria-role="link"
        aria-label="{{item.badge ? item.label + '，' + item.badge + ' 单' : item.label}}"
      >
        <!-- 全入口点击测试 2026-10-11：角标挂在文字右上（absolute），有无角标时文字都在同一高度 -->
        <view class="mine__order-label-wrap">
          <text class="mine__order-label">{{item.label}}</text>
          <text class="mine__order-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
        </view>
      </view>
      </view>
    </view>
  </view>

  <!-- 入口列表：三个入口进**同一张卡**，用发丝线分隔
       @why 不三个入口三张卡：三张卡之间会露出底色缝，读起来是三块孤立内容；
            一张卡 + 发丝线读起来是"一份菜单"，而菜单正是这一页的东西。 -->
  <view class="ws-gutter mine__menu-wrap">
    <view class="ws-card mine__menu">
      <view
        class="mine__entry"
        wx:for="{{rows}}"
        wx:key="key"
        data-key="{{item.key}}"
        hover-class="ws-press"
        bindtap="onMenuTap"
        aria-role="link"
        aria-label="{{item.label}}"
      >
        <text class="mine__entry-text">{{item.label}}</text>
        <!-- 右箭头：用字符 › 而不是图标组件——本页唯一的方向提示，
             引组件会让"三个入口"多一个可选渲染分支。 -->
        <text class="mine__entry-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 剩余清单 4-2：联系客服（只在服务端给了联系方式时出现；可复制的行点一下即复制） -->
  <!-- 体验排查 2026-10-14：客服未设置时也给一句话，别让从订单 / 支付页点「联系客服」过来的人扑空 -->
  <view class="ws-gutter mine__menu-wrap" wx:if="{{supportLoaded && support.length === 0}}">
    <view class="ws-card mine__card">
      <text class="ws-note">联系客服</text>
      <text class="ws-caption line-block">客服联系方式暂未设置。订单问题可在「订单」里查看进度；稍后再来这里看。</text>
    </view>
  </view>
  <view class="ws-gutter mine__menu-wrap" wx:if="{{support.length > 0}}">
    <view class="ws-card mine__card">
      <text class="ws-note">联系客服</text>
      <!-- 全入口点击测试 2026-10-11：可复制的行右侧写「复制」（原先能点却没有任何提示）；行高与上面的菜单一致 -->
      <view
        class="mine__row mine__support-row"
        wx:for="{{support}}"
        wx:key="key"
        data-key="{{item.key}}"
        data-value="{{item.copyable ? item.value : ''}}"
        hover-class="{{item.copyable ? 'ws-press' : 'none'}}"
        bindtap="onCopySupport"
      >
        <text class="ws-note">{{item.label}}</text>
        <text class="mine__value mine__support-value" user-select>{{item.value}}</text>
        <text class="mine__support-act" wx:if="{{item.copyable}}">{{supportCopied === item.key ? '已复制' : '复制'}}</text>
      </view>
    </view>
  </view>
</view>
