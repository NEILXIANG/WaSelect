/**
 * 「我的」页样式（S3 已切到设计体系基础类）。
 *
 * ⚠️ 颜色与尺寸一律走 app.wxss 的 `--ws-*` token（design-token 门禁会扫描本文件，
 * 硬编码色值 / 非 0 尺寸字面量直接红）。
 *
 * @why 入口块**不加** `.entry` 之类的类：`.ws-card` 已经给了间距 / 白底 / 圆角，
 *      可点这件事在小程序里没有"鼠标悬停"可表达，加一个类只为了写 `cursor: pointer`
 *      是自欺（那个属性在真机上没有任何效果）。唯一需要的差别是文案的字号与颜色。
 */

/* ── 页头 ────────────────────────────────────────────────────────
   S4：标题本身由 `ws-section-head` 组件给，这里只补"离页顶多远"。 */
.mine__head {
  padding-top: var(--ws-space-card);
}

/* ── 登录态 ──────────────────────────────────────────────────── */
.mine__card {
  padding: var(--ws-space-stack);
}

.mine__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

/* 值：主色 + 正文字号，与左侧 muted 小标签区分开 */
.mine__value {
  color: var(--ws-ink);
  font-size: var(--ws-f-sm);
  word-break: break-all;
}

/* ── 入口菜单 ────────────────────────────────────────────────── */
.mine__menu-wrap {
  margin-top: var(--ws-space-stack);
}

.mine__menu {
  padding: 0 var(--ws-space-stack);
}

.mine__entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* M-19（AJ-406）：入口整行可点，高度 ≥ --ws-touch-min（约 44pt） */
  min-height: var(--ws-touch-min);
  padding: var(--ws-space-stack) 0;
}

/* 入口之间：非第一个才给上边线（第一个贴着卡片上沿，加线会变成双线） */
.mine__entry + .mine__entry {
  border-top: var(--ws-border-width) solid var(--ws-line);
}

/* 入口文案：主色 + 正文字号
   @why 不用 muted 小字：三个入口用 muted 小字看起来像三段说明文字，不像可以点的东西 */
.mine__entry-text {
  color: var(--ws-ink);
  font-size: var(--ws-f-base);
}

.mine__entry-arrow {
  color: var(--ws-ink-faint);
  font-size: var(--ws-f-md);
}

/* M-17：重新登录按钮与重试失败的说明（与登录态同一张卡） */
.mine__retry {
  margin-top: var(--ws-space-stack);
}

.mine__retry-note {
  display: block;
  margin-top: var(--ws-space-inline);
  color: var(--ws-danger);
}

/* M-10 附（AJ-408）：四个订单入口一行等分。
   全入口点击测试 2026-10-11：卡片上加标题行「我的订单 · 全部订单 ›」，入口行在其下 */
/* 左右内边距与下方菜单卡片一致：两张卡的标题左边对齐（实测原先差 8px） */
.mine__orders {
  padding-left: var(--ws-space-stack);
  padding-right: var(--ws-space-stack);
}

.mine__orders-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--ws-touch-min);
  padding-bottom: var(--ws-space-hair);
  border-bottom: var(--ws-border-width) solid var(--ws-line);
}

.mine__orders-title {
  font-size: var(--ws-f-base);
  color: var(--ws-ink);
}

.mine__order-row {
  display: flex;
  margin-top: var(--ws-space-hair);
}

.mine__order-entry {
  flex: 1;
  min-height: var(--ws-touch-min);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mine__order-label {
  font-size: var(--ws-f-sm);
  color: var(--ws-ink);
}

/* 全入口点击测试 2026-10-11：角标挂在文字右上、不占位（原先占一行，把文字顶下去、与其它入口对不齐）；
   与底栏购物车角标同一套（--ws-danger、同尺寸），同一种提醒不该两种颜色 */
.mine__order-label-wrap {
  position: relative;
}

.mine__order-badge {
  position: absolute;
  top: calc(-1 * var(--ws-space-stack));
  left: 100%;
  min-width: var(--ws-space-card);
  padding: 0 var(--ws-space-hair);
  border-radius: var(--ws-radius-pill);
  background: var(--ws-danger);
  color: var(--ws-ink-inverse);
  font-size: var(--ws-f-caption);
  line-height: var(--ws-space-card);
  text-align: center;
}

/* 全入口点击测试 2026-10-11：联系客服各行——触控高度与菜单一致；值右对齐，可复制的行末尾「复制」 */
.mine__support-row {
  min-height: var(--ws-touch-min);
  align-items: center;
}

.mine__support-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  word-break: break-all;
}

.mine__support-act {
  flex: none;
  margin-left: var(--ws-space-stack);
  font-size: var(--ws-f-sm);
  color: var(--ws-accent);
}
