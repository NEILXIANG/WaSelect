/**
 * 全局样式 + design token（约束五：UI 不写死）。
 *
 * @why 颜色、间距、圆角一律走 CSS 变量：改版式时只改这一处，
 *      不需要动任何页面样式，也不会出现"这个页面的间距忘了改"。
 * @limitation 小程序对 CSS 变量的支持要求基础库 >= 2.9.0；低于此版本会整体失效（回落到无样式），
 *              不是"部分生效"，所以要么全用要么全不用，不要混写。
 */
page {
  --ws-color-bg: #f6f6f6;
  --ws-color-card: #ffffff;
  --ws-color-fg: #1a1a1a;
  --ws-color-muted: #8a8a8a;
  --ws-color-error: #c0392b;

  /* ⚠️ 间距只有两档（大/小）。**刻意不提供任意档位**——
     每加一档就多一种"这个页面用了另一档"的可能，最后版式又散了。
     真需要新档位时在这里加，并给它一个**说明用途**的名字（如 --ws-space-card），不要叫 -xs/-xxs。 */
  --ws-space: 24rpx;
  --ws-space-sm: 12rpx;
  /* 分隔线宽度：1rpx 在 2x/3x 屏上是"最细可见线"，写死在页面里会让改线宽变成逐页改。 */
  --ws-border-width: 1rpx;
  --ws-radius: 12rpx;
  --ws-font: 28rpx;
  --ws-font-sm: 24rpx;

  background: var(--ws-color-bg);
  color: var(--ws-color-fg);
  font-size: var(--ws-font);
}

.card {
  margin: var(--ws-space);
  padding: var(--ws-space);
  background: var(--ws-color-card);
  border-radius: var(--ws-radius);
}

.btn {
  margin-top: var(--ws-space);
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.label {
  color: var(--ws-color-muted);
  font-size: var(--ws-font-sm);
}

.value {
  font-size: var(--ws-font-sm);
  word-break: break-all;
}

.error {
  color: var(--ws-color-error);
  font-size: var(--ws-font-sm);
}
