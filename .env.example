# 环境变量模板 —— 复制为 .env 后填写；.env 已被 .gitignore 排除，绝不入库
# 用法：cp .env.example .env
# 占位阶段（无 AppID / 未签约机构）除 DATABASE_URL 外均可留空，支付用 PAYMENT_PROVIDER=mock

# ── 微信小程序 ──────────────────────────────
APP_ID=                       # 小程序 AppID（境外主体注册后取得）
APP_SECRET=                   # 小程序 Secret（仅服务端使用，绝不下发前端）

# ── 服务端 ──────────────────────────────────
NODE_ENV=development          # development | staging | production
PORT=3000
JWT_SECRET=                   # 自定义 token 密钥（openssl rand -hex 32）
ADMIN_OPENIDS=                # 管理员 openid 列表，逗号分隔（内嵌后台可见性）

# ── 数据库 ──────────────────────────────────
# 本地：brew 原生 postgresql@16，库 japan_shop
DATABASE_URL=postgresql://neilxiang@localhost:5432/japan_shop

# ── 货币锚（JPY 唯一，勿改）────────────────
PRICING_ANCHOR=JPY            # 定价锚 = 结算币 = 记账币（ADR-09）
DISPLAY_CURRENCIES=CNY,USD    # 展示币：小程序内 CNY 参考价、H5 USD 报价；JPY 恒为主价（技术文档 v0.3 §2.2）
FX_BUFFER_RATE=0.03           # 汇率缓冲 3%，写入 fx_rates.buffer
ORDER_PAYMENT_TTL_MIN=30      # 未支付自动关单（状态机 expired）
AUTO_DELIVER_DAYS=15          # 发货后自动签收
AUTO_COMPLETE_DAYS=7          # 签收后自动完成

# ── 支付（PaymentProvider 适配层）────────────
# 可同时启用多个通道，逗号分隔：mock | stripe | wechat（技术文档 v0.3 §4，ADR-15）
# I1 = mock,stripe（Stripe test mode）；R1 通过后加 wechat
PAYMENT_CHANNELS=mock,stripe
WECHAT_INSTITUTION_MERCHANT_ID=   # 日本持牌收单机构（机构定后填）
WECHAT_INSTITUTION_API_KEY=
STRIPE_SECRET_KEY=            # Stripe Japan（test mode 不需公司资料）
STRIPE_WEBHOOK_SECRET=        # stripe listen --forward-to localhost:3000/api/v1/pay/callback/stripe
CHECKOUT_BASE_URL=http://localhost:5173   # H5 收银页（生产 https://checkout.<domain>）
HANDOFF_TTL_SEC=300           # 小程序 → H5 一次性票据有效期

# ── 对象存储（Cloudflare R2，S3 兼容）────────
# 商品图/静态资源必须走 R2 + CDN，不由应用服务器出流量（Render egress 仅 5GB/月）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── 对外域名 ────────────────────────────────
# 小程序 request 合法域名：开局一次性规划 dev/stg/prod，微信后台每月仅可修改 5 次
PUBLIC_API_BASE=http://localhost:3000
