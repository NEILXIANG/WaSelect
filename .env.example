# 环境变量模板 —— 复制为 .env 后填写；.env 已被 .gitignore 排除，绝不入库
# 用法：cp .env.example .env
# 占位阶段（无 AppID / 未签约机构）除 DATABASE_URL、JWT_SECRET 外均可留空，支付用 PAYMENT_CHANNELS=mock
# 口径：《技术文档 v0.5》§8

# ── 微信小程序 ──────────────────────────────
APP_ID=                       # 小程序 AppID（境外主体注册后取得）。⚠️ 生产必配：缺了装配层不建 wechatAuth、登录全 500，loadConfig 启动期拒启。staging **不**强制——AppID 依赖日本公司登记（粗估 6–10 周），在那之前强制等于把 staging 判死（config.ts 规则 1d）
APP_SECRET=                   # 小程序 Secret（仅服务端使用，绝不下发前端）。与 APP_ID 成对：只配一个是配置错误（登录 500）
WECHAT_DEV_LOGIN=             # dev 登录前缀（AppID 未下来前的本机/CI 联调；非空即启用，openid=前缀+code；⚠️ 等价无密码登录，生产/staging 配置会被 loadConfig 拒启）

# ── 服务端 ──────────────────────────────────
NODE_ENV=development          # development | staging | test | production（test 由 Vitest 自动设置，配置层必须认得它，见 D17）
PORT=3000
HOST=0.0.0.0                  # 监听地址。**生产必须 0.0.0.0**（容器平台从宿主机外部探端口，绑 127.0.0.1 会导致健康检查超时/发布失败）；代码默认值已是 0.0.0.0，此项仅供本地想只绑回环时改为 127.0.0.1
TRUST_PROXY_HOPS=1            # 可信反代层数（D23）。**必须是层数，不是 true**：true 时客户端自造 X-Forwarded-For 就能伪造 IP（未来按 IP 限流/锁定会被一秒绕过）。Render=1；本机直连=0。层数宁小勿大：少了取到的是代理 IP（错但不可伪造），多了才会重新可伪造。⚠️ **代码默认值是 0（A2/AJ-197）："Render=1"至今没有 @measured**，文档写 api 前挂 Cloudflare，若属实则应为 2；生产由 render.yaml 显式给值，不许依赖默认。定值是 staging 实测 XFF 之后的事
JWT_SECRET=                   # 自定义 token 密钥（openssl rand -hex 32）
ADMIN_OPENIDS=                # 管理员 openid 列表，逗号分隔（首次登录时写入 users.is_admin；管理端为独立 Web，ADR-21）。⚠️ 当前无使用方（未实现，AJ-176）：config.ts 只定义、全仓无读取；且小程序登录只签用户 token（aud=mp），这条"提为管理员"路径在现设计下走不通
ADMIN_EMAIL=                  # 初始管理员邮箱（D-38 ⑤）：启动时若无此邮箱（大小写不敏感）的账号则建管理员；已有则不动（不改口令、不提权）。只配它、不配下一项也是允许的：表示"管理员已建号、口令已从平台删除"，此时 seed 跳过并打一条 warn（B17 / AJ-209）
ADMIN_INITIAL_PASSWORD=       # 初始管理员密码（≥12 位，N11；启动 seed 时预哈希 + bcrypt 为 password_hash）。**只建号不改号**：改这个变量不会影响已有账号。建号后从平台删掉本变量即可（B17 之前删了会拒绝启动）；需要轮换时用本机 CLI：`npm run admin:password -- <邮箱> <新口令>`（会同时 token_ver+1 让旧 token 失效）

# ── 数据库 ──────────────────────────────────
# 版本：Postgres 16（与生产一致）。代码里有硬闸门 assertPostgresMajor(>=16)，版本不符直接启动失败
# 本地：brew 原生 postgresql@16，库 japan_shop；<user> 填本机 OS 用户名（brew 默认免密）
DATABASE_URL=postgresql://<user>@localhost:5432/japan_shop
# 测试库（与开发库分开，避免误删真实数据）。不填则按 DATABASE_URL 的同机同角色推导出 japan_shop_test
TEST_DATABASE_URL=
TEST_ADMIN_DB_URL=            # 建测试库用的管理库连接串；不填则推导为同机 postgres 库
# ⚠️ 测试库安全闸门（test/db/test-db.ts）：resetTestDb 会 TRUNCATE 所有业务表，
#    因此连接串必须指向「本机」且库名以 _test 结尾，否则拒绝运行——防止配错一次清空开发库。
#    设为 1 = 允许连到远端专用测试实例（后果自负：那个库会被清空）
ALLOW_REMOTE_TEST_DB=

# ── 货币锚（JPY 唯一，勿改）────────────────
PRICING_ANCHOR=JPY            # 定价锚 = 结算币 = 记账币（ADR-09）
DISPLAY_CURRENCIES=CNY,USD    # 展示币（三币并列：円主价 + $ + ¥，D-36）；扣款币种在支付时按通道定：wechat JPY / stripe USD（D-33）
FX_BUFFER_RATE=0.03           # 汇率缓冲 3%，写入 fx_rates.buffer
                              # 关税率**不在这里**：真源是 duty_rates(origin,dest,rate) 表（010 迁移 + seed，
                              #   现为 ('JP','US',0.15) 占位口径，13b 待定；改口径改数据不改代码）
FREE_SHIPPING_JPY=            # 包邮阈值（整数円；空 = 不包邮）。运费分档在 shipping_rates 表
MAX_ORDER_JPY=180000          # 单笔订单上限（D-42：低于 ¥200,000 出口申报阈值与 Zonos 预付上限；超出提示拆单 40906）
                              # ⚠️ 该阈值的**前提是走邮便物（邮寄包裹）**：税関 FAX6201e——邮便物内容品 ≤ ¥200,000 无需向税关输出申告，
                              #    只填面单内的「税関告知書」；> ¥200,000 才需正式申告（invoice + 日本郵便/通関業者，D-61）。
                              #    **改用佐川 / FedEx / DHL 等"货物"渠道时此依据失效**（货物输出普遍要申告，没有 20 万这档豁免），
                              #    届时本值必须重新评估——渠道一改而这里不改，是最典型的静默失效。
MAX_OPEN_ORDERS_PER_USER=3    # 每个用户同时存在的未付款订单上限（AJ-240：库存在建单时即扣，没有上限一个账号就能占满全店库存；超出 40913）
PACKAGING_WEIGHT_G=250        # 包材+外箱自重（D-42：进 quote 与建单的运费分档重量；与测算模型 B46 一致）
ORDER_PAYMENT_TTL_MIN=30      # 未支付自动关单（状态机 expired）
SHIP_WITHIN_BUSINESS_DAYS=7   # 发货时限承诺（工作日，1–30）：商品详情「付款后 N 个工作日内发出」（FTC 邮购规则，D-39⑦；AJ-180）。只是展示承诺，不驱动作业
CALLBACK_ORDER_GRACE_MS=900000 # 回调早到宽限期（AJ-32）：订单不存在且距首次到达 ≤ 此值 → 503 让机构重发；超过 → 2xx + error 告警转对账
SCHEDULER_TICK_MS=60000       # 常驻调度器 tick 间隔（D-43：web 进程内 setInterval + pg_try_advisory_lock；不是 Render Cron Job）
SHUTDOWN_READY_DELAY_MS=5000  # 停机摘流等待（N7）：/readyz 转 503 后等平台健康检查发现再 close；0=不等（开发/测试用）
SHUTDOWN_EVENT_DRAIN_MS=8000  # 停机时"等异步领域事件订阅者跑完"的上限（B13/AJ-202）：取消/关单后作废机构支付会话的动作若被停机打断，已取消的单在会话自然过期前还能付款；8s = 出站总预算 6s + 2s 余量；0=不等。它与上面一项**相加**计入停机总时长，平台停机宽限必须大于两者之和
SHUTDOWN_JOB_WAIT_MS=5000     # 停机时"等**后台作业**跑完"的上限（OPS3-05）：在途 tick 与 202 之后仍在跑的 daily 作业都不是 HTTP 请求，排空与事件 drain 都等不到它们；不等的话 tick 提交的事件会撞上已关闭的连接池，机构会话没作废 ⇒ 已过期/已取消的单还能被付款。5s 够一轮慢 tick 善终；0=不等。它与 SHUTDOWN_READY_DELAY_MS / SHUTDOWN_EVENT_DRAIN_MS **串行相加**计入停机总时长
SHUTDOWN_TOTAL_BUDGET_MS=27000 # 停机**总预算**（INF3-01）：从收到 SIGTERM 那一刻起算，到点直接 exit(1) 并记 shutdown_budget_exhausted。AJ-237 之后"排空失败"分支会继续走 afterDrain，而 db.end() 会等在途事务跑完、没有自有上限（实测可达 31s+），超过平台停机宽限 30s 就会被 SIGKILL、最后几行日志（含清理留痕）一起丢失。27s = 30s 宽限 − 3s；0=不设预算（仅测试）
SHUTDOWN_BUDGET_FLUSH_MS=200  # 总预算到点后、真正 exit 之前的日志 flush 窗口（INF3-01）：直接 exit 会丢 SonicBoom 缓冲里最后几行——而那几行正是"清理做到了哪一步"的唯一证据。比 exit 宽限 2s 短得多，因为此刻已经超预算了
TERMS_VERSION=TOS-2026-09-20  # 当前生效条款版本；GET /terms 下发给小程序，建单必传且必须相等，否则 40011（D-43/D-45）
INTERNAL_JOB_SECRET=          # 每日 Cron Job 调 POST /internal/jobs/daily 的共享密钥，Header X-Internal-Job-Secret；端点 202 后异步执行（D-43/D-45）；≥32 字符（N11）。已挂载（U7b：Render Cron Job 调它，结果写 job_runs('daily')，看门狗读这张表）。调用方：render.yaml 已声明 cron 服务 waselect-daily（UTC 18:10 = JST 03:10），经 fromService 与 web 服务共享本密钥（一致性审计 C1，AJ-176）
ORIGIN_VERIFY_SECRET=         # 源站校验密钥（A2/AJ-197）：**配了才生效**——非空时只接受带 `x-origin-verify` 且值相等的请求，其余 40301 origin_not_verified。用法：Cloudflare Transform Rule 注入该头 + 本变量，使源站不再可被 *.onrender.com 直连；**必须与 TRUST_PROXY_HOPS 成对**——只有源站不可直连，把层数往大调才不会让 XFF 重新可伪造。≥32 字符（N11）。刻意豁免 /healthz /readyz /api/v1/internal/jobs（平台内网直连，挡掉它们等于让实例被判死或 daily 静默停跑）。⚠️ **留空 = 闸门关闭**，这是当前状态：先等 staging 实测拓扑再开
AUTO_DELIVER_DAYS=30          # 发货后自动签收（D-39：EMS 到美 7–14 天 + 清关抽查，15 天会在货到前关闭售后窗口）。每日作业 auto_deliver 消费（AJ-182）；拒付中的单不自动签收
AUTO_COMPLETE_DAYS=7          # 签收后自动完成。每日作业 auto_complete 消费（AJ-182）；拒付中的单不自动完成

# ── 支付（PaymentProvider 适配层）────────────
# 可同时启用多个通道，逗号分隔：mock | stripe | wechat（技术文档 v0.5 §4，ADR-15/22）
# I1 = mock,stripe（Stripe test mode）；R1 通过后加 wechat
PAYMENT_CHANNELS=mock,stripe  # 逗号分隔；R1 通过后加 wechat。Stripe 走 Checkout 托管页（D-49），无需注册 payment method domain
WECHAT_INSTITUTION_MERCHANT_ID=   # 日本持牌收单机构（机构定后填）
WECHAT_INSTITUTION_API_KEY=
STRIPE_SECRET_KEY=            # Stripe Japan（test mode 不需公司资料）
# ⚠️ 除了配这个密钥，**回调端点自身**在 Dashboard 里还有一项独立的 API 版本设置：
#    必须 ≥ 2025-03-31.basil。低版本的 Session.currency 语义会在 Adaptive Pricing 时
#    变成"客户选的币种"，与 mark-paid 的严格比对冲突 → 钱已收、单卡在 pending_payment。
#    该项在控制台里，改了不会有任何测试变红，属**部署清单**项（AJ-257）。
STRIPE_WEBHOOK_SECRET=        # stripe listen --forward-to localhost:3000/api/v1/pay/callback/stripe
CHECKOUT_BASE_URL=http://localhost:5173   # 短链域名（生产 https://checkout.<domain>：Cloudflare Pages 静态站，/o/* 302 到 api 的 /pay/link；D-49）
# HANDOFF_TTL_SEC / H5_ENTRY_MODE 已删除（D-49：无 web-view 后备、无一次性票据；短链 token 订单存续期内可重复打开）
RATE_LIMIT_LOGIN_PER_15MIN=5  # IP 限流（D-52）：POST /auth/admin/login，超限 42901（AJ-181 已挂载）。账号维度另有「连续失败 5 次锁 15 分钟」（users 行上，迁移 014）
RATE_LIMIT_QUOTE_PER_MIN=30   # 公开写入口配额：报价/建单/发起支付/小程序登录/短链**各一个独立桶**（同一 IP 下互不消耗，避免 CGNAT 共享出口把无关用户一起拒）；已接线（publicWrite(routeKey)）
MOCK_CALLBACK_SECRET=         # mock 回调 HMAC 密钥（骨架/审核期）。**独立于 JWT_SECRET**（泄露半径与轮换周期不同，P1-4）；生产启用 mock（=审核模式）时必填且不得与 JWT_SECRET 相同；开发/测试留空走占位值。⚠️ **配了就必须 ≥32 字符**（B19）：持有它可给任意订单落账，审核期这条通路是刻意暴露在公网的，短密钥可被在线枚举
REVIEW_MODE=off               # on = 审核期（首版上线前）专用：仅 REVIEW_SKU_ID 商品可下单、**仅允许 mock 通道**（AJ-30：审核期真实通道必须离线，防止测试下单产生真实扣款）
REVIEW_SKU_ID=

# ── 出站 HTTP（F12；数字在配置里，调参不发版）──
HTTP_TIMEOUT_MS=10000        # 单次请求超时。⚠️ 与下面总预算是**两道独立的闸**：只设单次超时的后果是 10s × 3 次 = 30s
HTTP_TOTAL_BUDGET_MS=6000    # 一次调用的总时长预算（所有重试加起来）。**产品决策**：用户能等多久，不是技术常数
CB_FAILURE_THRESHOLD=5       # 熔断：连续失败几次才跳闸。⚠️ 必须大于重试次数（3），否则一次请求就把上游判死
CB_COOLDOWN_MS=30000         # 熔断：跳闸后冷却多久才放第一个探测
CB_HALF_OPEN_PROBES=1        # 熔断：half_open 期间最多放几个探测（放多了会把刚恢复的上游砸回去）

# ── 通知与可观测性（D-40/D-41）──────────────
SENTRY_DSN=                   # Sentry（server / admin-web 两端；beforeSend 删 request 数据脱敏，D-52）（尚未实现——server 侧无任何消费方，配置暂不生效）
CORS_ORIGINS=https://admin.example.com,http://localhost:5174   # API 只放行 admin-web（D-49：checkout 是静态页不调 API）。本地联调必须含 5174（admin-web dev 端口，vite.config strictPort；⚠️ 5173 是 checkout 本地预览，两端同端口会互相挤占）；精确匹配不支持通配，端口漂移 = 跨域全挂
MAIL_PROVIDER_API_KEY=        # 邮件兜底服务商（Resend / AWS SES），contact_email 通知用。⚠️ 当前无使用方（未实现，AJ-176）
SUBSCRIBE_TMPL_PAID=          # 订阅消息模板 ID：支付成功（公众平台申请）。⚠️ 当前无使用方（未实现：订阅消息依赖 AppID，AJ-176）
SUBSCRIBE_TMPL_SHIPPED=       # 已发货。⚠️ 当前无使用方（未实现，AJ-176）
SUBSCRIBE_TMPL_DELIVERED=     # 已签收。⚠️ 当前无使用方（未实现，AJ-176）

# ── 对象存储（Cloudflare R2，S3 兼容）────────
# 商品图/静态资源必须走 R2 + CDN，不由应用服务器出流量（Render egress 仅 5GB/月）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
IMG_BASE_URL=https://img.example.com   # R2 自定义域，只做展示；上传走 POST /admin/upload 服务端中转并生成 thumb/card/detail

# 上传存储驱动（I2 U-I4）：fs=本地盘（仅 development，Render 易失盘）、memory=进程内存（仅 test/e2e）。
# 留空的语义按环境定：development→fs，test→memory，production/staging→未配置（上传 50000 响亮拒绝）。
# ⚠️ 生产禁止显式设 fs/memory（config 跨字段规则 1d 拦：图会静默丢）；r2 适配器待凭据落地后启用。
STORAGE_DRIVER=
STORAGE_FS_DIR=                        # fs 驱动的落盘根目录，缺省 ./var/uploads

# ── 对外域名 ────────────────────────────────
# 小程序 request 合法域名：开局一次性规划 dev/stg/prod，微信后台每月仅可修改 5 次
PUBLIC_API_BASE=http://localhost:3000
# admin-web 的 API 根地址（Vite 注入；⚠️ Vite 的 envDir 是 admin-web/——本文件（仓库根 .env）
# 不会被它加载，此项只作文档登记：本地 dev 不设即可（回落 localhost:3000），
# CF Pages 部署必须在平台环境变量里配 https 公网地址，否则 prebuild 闸门直接失败（二次审查 P2）
VITE_API_BASE_URL=
