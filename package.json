{
  "name": "waselect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "WaSelect 日本直邮跨境电商 monorepo（契约：WaSelectDoc 技术文档 v0.5 / api-contract 0.5.0）",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "server",
    "packages/shared"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:fast": "vitest run --project unit --changed HEAD~1",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:contract": "vitest run --project contract",
    "test:e2e": "vitest run --project e2e",
    "cov": "vitest run --project unit --coverage",
    "check:contract": "node scripts/check-contract.mjs",
    "db:migrate": "node node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations up",
    "db:migrate:down": "node node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations down",
    "gate": "npm run lint && npm run typecheck && npm run check:contract && npm run test:unit && npm run test:db && npm run test:contract && npm run test:e2e && npm run cov"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "pino": "^10.3.1"
  }
}
