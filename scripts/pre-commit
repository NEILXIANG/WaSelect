#!/usr/bin/env bash
# F0 提交门禁（薄转发，单一事实来源 = 根 package.json 的 scripts）：
# 只跑快速检查；完整门禁是 npm run gate（F1 起接入测试），由 CI 与交付前执行。
# N18：test:fast 必须在这里——"提交时绿、CI 才红"的反馈环慢几十分钟，
# 且 test:fast 只跑 --changed 关联用例，成本是秒级（没改动时按设计放空，见 vitest.config.mts T4）。
# @see docs/地基搭建清单.md F0/F1
set -e
cd "$(dirname "$0")/.."
# AJ-238：Node 主版本不对时，下面三步跑出来的结果都不算数——先过这一步
npm run check:node
npm run lint
npm run typecheck
npm run test:fast
